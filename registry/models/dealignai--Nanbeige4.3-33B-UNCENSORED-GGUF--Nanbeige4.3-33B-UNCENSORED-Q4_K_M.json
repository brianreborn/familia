   "lang": "python",
   "tool": "transformers",
   "kind": "code",
   "text": "from transformers import AutoModelForCausalLM, AutoTokenizer\n\nmodel_id = 'Nanbeige/Nanbeige4.3-33B'\ntokenizer = AutoTokenizer.from_pretrained(\n  model_id,\n  use_fast=False,\n  trust_remote_code=True\n)\nmodel = AutoModelForCausalLM.from_pretrained(\n  model_id,\n  torch_dtype='auto',\n  device_map='auto',\n  trust_remote_code=True\n)\n\nmessages = [{'role': 'user', 'content': 'Which number is bigger, 9.11 or 9.8?'}]\ninputs = tokenizer.apply_chat_template(\n  messages,\n  add_generation_prompt=True,\n  return_tensors='pt'\n).to(model.device)\noutput_ids = model.generate(inputs, max_new_tokens=1024)\nresponse = tokenizer.decode(output_ids[0][inputs.shape[-1]:], skip_special_tokens=True)\nprint(response)",
   "translation": {
    "translated": true,
    "params": [
     {
      "flag": "-n",
      "value": "1024",
      "from": "max_new_tokens: 1024"
     }
    ],
    "untranslatable": null
   },
