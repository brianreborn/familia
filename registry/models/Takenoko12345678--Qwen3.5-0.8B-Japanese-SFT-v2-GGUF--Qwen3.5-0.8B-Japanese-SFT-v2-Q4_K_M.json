   "lang": "python",
   "tool": "transformers",
   "kind": "code",
   "text": "from transformers import AutoModelForImageTextToText, AutoTokenizer\nimport torch\n\nmodel_id = \"Takenoko12345678/Qwen3.5-0.8B-Japanese-SFT-v2\"\ntok = AutoTokenizer.from_pretrained(model_id)\nmodel = AutoModelForImageTextToText.from_pretrained(model_id, dtype=torch.bfloat16, device_map=\"auto\")\n\nmessages = [{\"role\": \"user\", \"content\": \"雨の日の過ごし方を教えて。\"}]\ntext = tok.apply_chat_template(messages, tokenize=False, add_generation_prompt=True, enable_thinking=False)\ninputs = tok(text, return_tensors=\"pt\", add_special_tokens=False).to(model.device)\nout = model.generate(**inputs, max_new_tokens=512, do_sample=True, temperature=1.0, top_k=20, top_p=1.0)\nprint(tok.decode(out[0][inputs[\"input_ids\"].shape[1]:], skip_special_tokens=True))",
