   "lang": "python",
   "tool": "python",
   "kind": "code",
   "text": "requests.post(\"http://localhost:8000/v1/chat/completions\", json={\n    \"model\": \"autotrust/GEV-26B-Decide\",\n    \"messages\": [{\"role\": \"user\", \"content\": \"In one sentence, what is safety stock?\"}],\n    \"max_tokens\": 200, \"chat_template_kwargs\": {\"enable_thinking\": False}})",
