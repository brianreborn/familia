   "lang": "bash",
   "tool": "curl",
   "kind": "command",
   "text": "curl localhost:8000/v1/decide -H 'Content-Type: application/json' -d '{\n  \"kind\": \"choice\",\n  \"state\": \"A bat and a ball cost $1.10 in total. The bat costs $1.00 more than the ball.\",\n  \"question\": \"How much does the ball cost?\",\n  \"options\": [\"$0.10\", \"$0.05\", \"$1.00\", \"$0.55\"],\n  \"thinking\": \"auto\"}'",
   "doc": "base-card",
   "doc_sha": "eea849038e792cd09aa731d59d586f0eaf2c18f6",
   "scope": "model"
  },
  {
   "source": "autotrust/GEV-26B-Decide README.md:L447-454",
   "file": "README.md",
   "lines": [
    447,
    454
   ],
   "lang": "python",
   "tool": "python",
   "kind": "code",
   "text": "import requests\n\ndef decide(kind, state, question, options=None, thinking=\"auto\"):\n    body = {\"kind\": kind, \"state\": state, \"question\": question, \"thinking\": thinking, **({\"options\": options} if options else {})}\n    r = requests.post(\"http://localhost:8000/v1/decide\", json=body).json()\n    return dict(zip(r[\"options\"], r[\"probabilities\"])), r.get(\"thinking\", {}).get(\"used\")\n\ndecide(\"noul\", \"John was born on 29 February 1996.\", \"Was John's 7th birthday celebrated on a 29 February?\")",
   "doc": "base-card",
   "doc_sha": "eea849038e792cd09aa731d59d586f0eaf2c18f6",
   "scope": "model"
  },
  {
   "source": "autotrust/GEV-26B-Decide README.md:L460-463",
   "file": "README.md",
