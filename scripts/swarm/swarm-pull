def cap_text(s, n=4000):
    s = redact(s or "")
    if len(s) > n:
        return s[:n] + "\n... [truncated]\n"
    return s


def cmd_block(title, argv, timeout=15):
    if isinstance(argv, str):
        rc, out, err = run_shell(argv, timeout=timeout)
        shown = argv
    else:
        rc, out, err = run_cmd(argv, timeout=timeout)
        shown = " ".join(argv)
    lines = ["### " + title, "$ " + shown, "rc=%s" % rc]
    if out.strip():
        lines.append(cap_text(out, 2500))
    if err.strip():
        lines.append("stderr:\n" + cap_text(err, 800))
    lines.append("")
    return "\n".join(lines)


