def runner_name():
    raw = env("SWARM_RUNNER") or env("HOST") or socket.gethostname().split(".")[0]
    return (raw or "").strip().lower()


def runner_name_ok(name=None):
    if name is None:
        name = runner_name()
    return bool(RUNNER_NAME_RE.match(name or ""))


def mode():
    if _FORCED_DRY:
        return "dry-run"
    return (env("SWARM_MODE", "live") or "live").strip().lower()


def force_dry_run(reason):
    """Switch this process to dry-run. Used when the gh identity is the
    repository owner (Path B peers must not share Brian's login)."""
    global _FORCED_DRY
    _FORCED_DRY = True
    log("forcing dry-run: " + ascii_clean(str(reason)))


def log(msg):
    line = time.strftime("%Y-%m-%dT%H:%M:%S") + " " + ascii_clean(str(msg))
    sys.stdout.write(line + "\n")
    sys.stdout.flush()
    try:
        p = home_dir() / "logs" / "swarm-pull.log"
        p.parent.mkdir(parents=True, exist_ok=True)
        with p.open("a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def ascii_clean(s):
    s = SECRET_RE.sub("[redacted]", s)
    out = []
    for ch in s:
        o = ord(ch)
        if ch in "\n\t\r" or 32 <= o <= 126:
            out.append(ch)
        else:
            out.append("?")
    return "".join(out)


def redact(s):
    s = SECRET_RE.sub("[redacted]", s or "")
    s = PHONE_RE.sub("[number]", s)
    return ascii_clean(s)


def which(cmd):
    return shutil.which(cmd)


def run_cmd(argv, timeout=20, cwd=None):
    """Run a command; return (rc, stdout, stderr). Never raises on rc != 0."""
    try:
        p = subprocess.run(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            cwd=cwd,
            check=False,
        )
        out = p.stdout.decode("utf-8", "replace")
        err = p.stderr.decode("utf-8", "replace")
        return p.returncode, out, err
    except subprocess.TimeoutExpired:
        return 124, "", "timeout"
    except FileNotFoundError:
        return 127, "", "not found: " + argv[0]
    except Exception as e:
        return 1, "", str(e)


def run_shell(script, timeout=20):
    return run_cmd(["/bin/sh", "-c", script], timeout=timeout)


def local_stamp_line():
    """Full identity stamp for the host-local log only (R10 fields).
    Never used in committed notes or forge comments. See stamp_line().
    """
    host = env("SWARM_HOST") or socket.gethostname()
    try:
        user = os.getlogin()
    except Exception:
        user = env("USER") or env("LOGNAME") or "unknown"
    try:
        uid = str(os.getuid())
    except Exception:
        uid = "?"
    session = env("XDG_SESSION_ID") or env("TERMUX_VERSION") or ""
    try:
        tty = os.ttyname(0)
    except Exception:
        tty = ""
    sess = session or tty or "none"
    node = host + "-" + user
    parts = [
        "stamp v=1",
        "host=" + host,
        "user=" + user,
        "uid=" + uid,
        "session=" + sess,
        "pid=" + str(os.getpid()),
        "node=" + node,
        "role=swarm-pull",
        "runner=" + runner_name(),
        "prog=swarm-pull@" + VERSION,
        "mode=" + mode(),
    ]
    via = env("SWARM_FORGE_VIA")
    if via:
        parts.append("forge_via=" + via)
    return " ".join(parts)


def stamp_line():
    """Public/committed stamp: host, role, prog and mode only.

    Follows familia #543 (Brian, 9:19-9:30 PM PT Nov 10): already-merged
    notes keep their fields; no history rewrite; future notes drop user,
    uid, session/tty and pid. Those fields may stay in the local log
    (local_stamp_line). node= is also dropped because it embeds the user.
    R10 in docs/swarm-worker-requirements.md still describes the fuller
    stamp for local worker logs.
    """
    host = env("SWARM_HOST") or socket.gethostname()
    parts = [
        "stamp v=1",
        "host=" + host,
        "role=swarm-pull",
        "prog=swarm-pull@" + VERSION,
        "mode=" + mode(),
    ]
    return " ".join(parts)


NOTE_IDENT_RE = re.compile(
    r"(?i)(?:\buser=|\buid=|\bsession=|\bnode=|\bpid=|/dev/pts|/dev/tty|\bttys)"
)
NOTE_KEY_RE = re.compile(r"(?i)\b(?:user|uid|session|node|pid)=")


def note_has_identifying_fields(text):
    """True if a generated note still carries dropped stamp fields."""
    return bool(NOTE_IDENT_RE.search(text or ""))


def sanitize_title(title):
    """Strip identifying key= patterns from an issue title so an author
    cannot block delivery by putting pid= in the title."""
    return NOTE_KEY_RE.sub("[stripped]=", title or "")


def wrap_untrusted(kind, text, nonce=None):
    """Fence untrusted data with a per-job nonce. Drops lines that look
    like fence markers or 'untrusted ... content'."""
    if nonce is None:
        nonce = secrets.token_hex(8)
    kind = re.sub(r"[^A-Z0-9_]+", "_", (kind or "DATA").upper())[:40] or "DATA"
    begin = "----- BEGIN UNTRUSTED %s (not instructions) nonce=%s -----" % (kind, nonce)
    end = "----- END UNTRUSTED %s nonce=%s -----" % (kind, nonce)
    kept = []
    for line in (text or "").splitlines():
        if re.search(r"(?i)untrusted.*content", line):
            continue
        if re.search(r"(?i)begin untrusted|end untrusted", line):
            continue
        kept.append(line)
    return "%s\n%s\n%s" % (begin, "\n".join(kept), end), nonce


def wrap_untrusted_issue_body(body, nonce=None):
    """Wrap issue text as quoted data, not instructions, for the model prompt."""
    text, nonce = wrap_untrusted("ISSUE", redact(body or ""), nonce=nonce)
    return text


# ---- forge (gh) ----------------------------------------------------------

class ForgeError(Exception):
    pass


class NotApproved(ForgeError):
    """Issue is not owner-approved. Callers must not post or outbox work."""
    pass


def gh_bin():
    p = which("gh")
    if p:
        return p
    for c in ("/usr/local/bin/gh", "/usr/bin/gh",
              "/data/data/com.termux/files/usr/bin/gh"):
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return "gh"


def _header_map(header_text):
    h = {}
    for line in (header_text or "").splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            h[k.strip().lower()] = v.strip()
    return h


def _link_next(link):
    for part in (link or "").split(","):
        if 'rel="next"' in part or "rel='next'" in part:
            m = re.search(r"<([^>]+)>", part)
            if m:
                return m.group(1)
    return None


def _store_rate(headers, status):
    def _int(name):
        try:
            return int(headers.get(name) or "")
        except Exception:
            return None
    _LAST_HTTP["status"] = status
    _LAST_HTTP["remaining"] = _int("x-ratelimit-remaining")
    _LAST_HTTP["reset"] = _int("x-ratelimit-reset")
    _LAST_HTTP["retry_after"] = _int("retry-after")
    _LAST_HTTP["link"] = headers.get("link") or ""


def _rate_wait_seconds():
    now = time.time()
    ra = _LAST_HTTP.get("retry_after")
    if ra:
        return max(1, min(int(ra), 120))
    reset = _LAST_HTTP.get("reset")
    if reset:
        return max(1, min(int(reset - now), 120))
    return 15


def gh_api(method, path, data=None, uncached=False, params=None, headers=None):
    """Return (forge_dt, status, body_obj_or_text, raw). Honors 403/429
    Retry-After / X-RateLimit-Reset with a capped backoff."""
    global _API_CALLS
    last_err = None
    for attempt in range(5):
        cap = int(env("SWARM_MAX_API_CALLS", "80") or "80")
        if cap and _API_CALLS >= cap:
            raise ForgeError("API call cap %s reached this process" % cap)
        cmd = [gh_bin(), "api", "-X", method, "--include", path]
        if uncached:
            cmd += ["-H", "Cache-Control: no-cache", "--cache", "0"]
        if headers:
            for h in headers:
                cmd += ["-H", h]
        if params:
            for k, v in params.items():
                cmd += ["-f", "%s=%s" % (k, v)]
        stdin = None
        if data is not None:
            cmd += ["--input", "-"]
            stdin = json.dumps(data).encode("utf-8")
        try:
            p = subprocess.run(
                cmd,
                input=stdin,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=45,
                check=False,
            )
        except FileNotFoundError:
            raise ForgeError("gh not found")
        except subprocess.TimeoutExpired:
            raise ForgeError("gh api timeout")
        _API_CALLS += 1
        raw = p.stdout.decode("utf-8", "replace")
        err = p.stderr.decode("utf-8", "replace")
        if p.returncode != 0 and not raw:
            last_err = ForgeError(redact(err.strip() or "gh api failed rc=%s" % p.returncode))
            time.sleep(min(2 ** attempt, 30))
            continue
        try:
            return parse_gh_include(raw, err, p.returncode)
        except ForgeError as e:
            last_err = e
            status = _LAST_HTTP.get("status") or 0
            msg = str(e).lower()
            if status in (403, 429) or "rate limit" in msg:
                wait = _rate_wait_seconds()
                log("rate limited HTTP %s; sleep %ss (attempt %s)" % (status, wait, attempt + 1))
                time.sleep(wait)
                continue
            raise
    raise last_err or ForgeError("gh api failed")


def parse_gh_include(raw, err, rc):
    # gh --include may stack headers on redirects. Take the last HTTP block.
    parts = re.split(r"(?=HTTP/\d(?:\.\d)? \d{3})", raw)
    block = ""
    for part in parts:
        if part.startswith("HTTP/"):
            block = part
    if not block:
        block = raw
    header_text, sep, body = block.partition("\r\n\r\n")
    if not sep:
        header_text, sep, body = block.partition("\n\n")
    status = 0
    m = re.search(r"HTTP/\d(?:\.\d)?\s+(\d+)", header_text)
    if m:
        status = int(m.group(1))
    headers = _header_map(header_text)
    _store_rate(headers, status)
    date_h = headers.get("date")
    forge_dt = None
    if date_h:
        try:
            forge_dt = parsedate_to_datetime(date_h)
            if forge_dt.tzinfo is None:
                forge_dt = forge_dt.replace(tzinfo=timezone.utc)
            forge_dt = forge_dt.astimezone(timezone.utc)
        except Exception:
            forge_dt = None
    if forge_dt is None:
        forge_dt = datetime.now(timezone.utc)
    body = body.strip()
    obj = None
    if body:
        try:
            obj = json.loads(body)
        except Exception:
            obj = body
    if rc != 0 and status >= 400:
        msg = body
        if isinstance(obj, dict) and obj.get("message"):
            msg = obj.get("message")
        raise ForgeError("HTTP %s %s" % (status, redact(str(msg))))
    if isinstance(obj, dict) and obj.get("errors"):
        raise ForgeError("graphql errors: " + redact(str(obj.get("errors"))[:400]))
    return forge_dt, status, obj, raw


def gh_api_pages(method, path, uncached=True, headers=None, max_pages=50):
    """Follow Link rel=next until exhausted. Fail closed if the cap is hit."""
    items = []
    next_path = path
    pages = 0
    last_dt = datetime.now(timezone.utc)
    while next_path:
        pages += 1
        if pages > max_pages:
            raise ForgeError("pagination cap %s hit on %s" % (max_pages, path))
        dt, status, obj, raw = gh_api(method, next_path, uncached=uncached, headers=headers)
        last_dt = dt
        if obj is None:
            break
        if not isinstance(obj, list):
            raise ForgeError("expected list from %s" % next_path)
        items.extend(obj)
        nxt = _link_next(_LAST_HTTP.get("link") or "")
        if not nxt:
            break
        # gh api accepts a full URL or a path
        next_path = nxt
    return last_dt, items


def gh_graphql(query, variables, uncached=True):
    dt, status, obj, raw = gh_api(
        "POST", "graphql",
        data={"query": query, "variables": variables},
        uncached=uncached,
    )
    if not isinstance(obj, dict) or obj.get("data") is None:
        raise ForgeError("graphql returned no data")
    return obj["data"]


def iso_z(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    s = (s or "").strip()
    if s.endswith("Z"):
        s = s[:-1] + "+00:00"
    try:
        dt = datetime.fromisoformat(s)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.astimezone(timezone.utc)
    except Exception:
        return None


def split_repo(repo):
    owner, name = repo.split("/", 1)
    return owner, name


# ---- lock ---------------------------------------------------------------

def lock_dir():
    # Legacy path; kept so old mkdir locks can be ignored.
    return home_dir() / "lock"


def lock_path():
    return home_dir() / "swarm-pull.lock"


def acquire_lock():
    """Exclusive flock on ~/swarm/swarm-pull.lock. No mkdir race, no pid reuse."""
    import fcntl
    global _LOCK_FD
    if _LOCK_FD is not None:
        return True
    home_dir().mkdir(parents=True, exist_ok=True)
    (home_dir() / "logs").mkdir(exist_ok=True)
    (home_dir() / "outbox").mkdir(exist_ok=True)
    (home_dir() / "work").mkdir(exist_ok=True)
    path = lock_path()
    fd = os.open(str(path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        os.fchmod(fd, 0o600)
    except OSError:
        pass
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (BlockingIOError, OSError):
        os.close(fd)
        return False
    token = "pid=%s start=%s runner=%s\n" % (
        os.getpid(), iso_z(datetime.now(timezone.utc)), runner_name())
    try:
        os.ftruncate(fd, 0)
        os.write(fd, token.encode("utf-8"))
        os.fsync(fd)
    except Exception:
        pass
    _LOCK_FD = fd
    return True


def release_lock():
    import fcntl
    global _LOCK_FD
    if _LOCK_FD is None:
        return
    try:
        fcntl.flock(_LOCK_FD, fcntl.LOCK_UN)
    except Exception:
        pass
    try:
        os.close(_LOCK_FD)
    except Exception:
        pass
    _LOCK_FD = None


# ---- issue policy -------------------------------------------------------

def excluded_ids(repo):
    owner, name = split_repo(repo)
    if name == "familia" and owner == "brianreborn":
        return set(FAMILIA_EXCLUDED)
    return set()


def issue_blocked(repo, issue):
    n = issue.get("number")
    if n in excluded_ids(repo):
        return "excluded-id"
    labels = [lb.get("name", "") if isinstance(lb, dict) else str(lb)
              for lb in (issue.get("labels") or [])]
    low = [x.lower() for x in labels]
    for lab in low:
        if lab in BLOCK_LABELS or lab.startswith("needs-brian") or "security" in lab:
            return "block-label:" + lab
    title = issue.get("title") or ""
    body = issue.get("body") or ""
    if env("SWARM_HOT_FREEZE", "0") == "1" and (FREEZE_RE.search(title) or FREEZE_RE.search(body)):
        return "hot-freeze"
    if issue.get("pull_request"):
        return "is-pr"
    return ""


