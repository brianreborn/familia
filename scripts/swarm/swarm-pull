def require_forge_clock(what="lease decision"):
    if _FORGE_DATE_OK is False:
        raise ForgeClockUnknown("no forge Date header; deferring %s" % what)


def server_now():
    """Forge time: local clock corrected by the last Date header seen."""
    return datetime.now(timezone.utc) + timedelta(seconds=_SERVER_SKEW)


class ApiBudgetExhausted(Exception):
    """Per-iteration / per-window API budget is spent. Not a ForgeError on
    purpose: callers must not treat it as a retryable forge failure."""
    pass


def api_budget_cap():
    try:
        return int(env("SWARM_MAX_API_CALLS", "80") or "80")
    except Exception:
        return 80


def api_window_sec():
    try:
        return max(60, int(float(env("SWARM_API_WINDOW_SEC", "3600") or "3600")))
    except Exception:
        return 3600


def reset_api_budget(now=None):
    """Start a fresh budget. cmd_loop calls this at the top of every
    iteration (Race NB1, Boundary R3)."""
    global _API_CALLS, _API_WINDOW_START
    _API_CALLS = 0
    _API_WINDOW_START = time.time() if now is None else now


def api_budget_reset_in(now=None):
    """Seconds until the current window resets on its own."""
    now = time.time() if now is None else now
    if _API_WINDOW_START is None:
        return 0
    return max(0, int(_API_WINDOW_START + api_window_sec() - now))


_ESSENTIAL_DEPTH = 0


def api_reserve():
    """Extra calls only claim, heartbeat and release may spend once the
    discovery budget is gone (Boundary L3)."""
    try:
        return max(0, int(env("SWARM_API_RESERVE", "20") or "20"))
    except Exception:
        return 20


_ESSENTIAL_KINDS = []


def api_release_floor():
    """Part of the reserve that claim attempts may not touch, so release
    and heartbeat always have budget (Boundary F1)."""
    try:
        return max(1, int(env("SWARM_API_RELEASE_FLOOR", "6") or "6"))  # G2
    except Exception:
        return 6


class essential_api(object):
    """Context for lease-keeping calls (claim, heartbeat, release). They may
    dip into the reserve so a busy iteration can still keep or drop its
    lease instead of leaving it to decay. kind="claim" stops at the
    release floor; "lease" (heartbeat, release) may use all of it."""

    def __init__(self, kind="lease"):
        self.kind = kind

    def __enter__(self):
        global _ESSENTIAL_DEPTH
        _ESSENTIAL_DEPTH += 1
        _ESSENTIAL_KINDS.append(self.kind)
        return self

    def __exit__(self, *exc):
        global _ESSENTIAL_DEPTH
        _ESSENTIAL_DEPTH = max(0, _ESSENTIAL_DEPTH - 1)
        if _ESSENTIAL_KINDS:
            _ESSENTIAL_KINDS.pop()
        return False


def _essential_kind():
    # Innermost lease context wins (release inside claim may use it all).
    return _ESSENTIAL_KINDS[-1] if _ESSENTIAL_KINDS else ""


def _essential(fn, kind="lease"):
    def wrapper(*a, **k):
        with essential_api(kind):
            return fn(*a, **k)
    wrapper.__name__ = fn.__name__
    wrapper.__doc__ = fn.__doc__
    return wrapper


def _api_budget_take(now=None):
    """Count one API call. A window older than SWARM_API_WINDOW_SEC resets
    by itself, so even a non-loop process never wedges forever. Essential
    (lease) calls may also use SWARM_API_RESERVE."""
    global _API_CALLS, _API_WINDOW_START
    now = time.time() if now is None else now
    if _API_WINDOW_START is None or now - _API_WINDOW_START >= api_window_sec():
        reset_api_budget(now)
    cap = api_budget_cap()
    if cap and _ESSENTIAL_DEPTH:
        extra = api_reserve()
        if _essential_kind() == "claim":
            extra = max(0, extra - api_release_floor())
        cap += extra
    if cap and _API_CALLS >= cap:
        raise ApiBudgetExhausted("API call budget %s spent for this iteration/window" % cap)
    _API_CALLS += 1


