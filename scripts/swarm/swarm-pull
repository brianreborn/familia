}
"""


def approval_labels():
    raw = env("SWARM_APPROVAL_LABELS", ",".join(DEFAULT_APPROVAL_LABELS))
    return tuple(x.strip().lower() for x in raw.split(",") if x.strip())


def allowed_repos():
    raw = env("SWARM_REPOS", env("SWARM_PIN_REPO", default_repo()))
    return set(x.strip() for x in raw.split(",") if x.strip())


def _actor_from(obj):
    if not isinstance(obj, dict):
        return {}
    if "login" in obj or "type" in obj or "databaseId" in obj or "id" in obj:
        return obj
    return obj.get("actor") or obj.get("user") or obj.get("author") or {}


def actor_login(obj):
    return (_actor_from(obj).get("login") or "").strip()


def actor_id(obj):
    src = _actor_from(obj)
    return src.get("databaseId") or src.get("id")


def actor_is_bot(obj):
    src = _actor_from(obj)
    typ = (src.get("type") or src.get("__typename") or "").lower()
    login = (src.get("login") or "").lower()
    return typ == "bot" or typ.endswith("bot") or login.endswith("[bot]")


def repo_owner_record(repo, allow_fetch=True):
    """Repository owner {login, id}. Fetch errors are not cached as a fallback."""
    if repo in _OWNER_CACHE:
        return _OWNER_CACHE[repo]
    owner, name = split_repo(repo)
    fallback_login = env("SWARM_OWNER", owner or "brianreborn")
    rec = {"login": fallback_login, "id": None, "fetched": False}
    if allow_fetch:
        try:
            _, _, obj, _ = gh_api("GET", "repos/%s/%s" % (owner, name))
            ow = (obj or {}).get("owner") or {}
            rec = {
                "login": ow.get("login") or fallback_login,
                "id": ow.get("id"),
                "fetched": True,
            }
            _OWNER_CACHE[repo] = rec
        except ForgeError:
            # Do not cache a fallback as if it were the forge owner.
            return rec
    return rec


def repo_owner_login(repo):
    """Repository owner login. Peers must not share this identity."""
    return repo_owner_record(repo).get("login") or env("SWARM_OWNER", "brianreborn")


def is_repo_owner_actor(repo, actor_obj, owner_rec=None):
    if actor_is_bot(actor_obj):
        return False
    rec = owner_rec or repo_owner_record(repo)
    if isinstance(rec, str):
        rec = {"login": rec, "id": None}
    rec = rec or {}
    aid = actor_id(actor_obj)
    oid = rec.get("id")
    if aid is not None and oid is not None:
        try:
            return int(aid) == int(oid)
        except Exception:
            pass
    login = actor_login(actor_obj)
    owner = rec.get("login") or ""
    return bool(login) and bool(owner) and login.lower() == owner.lower()


def forge_viewer(allow_fetch=True):
    if _VIEWER_CACHE:
        return _VIEWER_CACHE
    if not allow_fetch:
        return {"login": "", "id": None}
    _, _, obj, _ = gh_api("GET", "user")
    rec = {
        "login": ((obj or {}).get("login") or "").strip(),
        "id": (obj or {}).get("id"),
        "type": (obj or {}).get("type"),
    }
    _VIEWER_CACHE.update(rec)
    return rec


def viewer_is_repo_owner(repo, viewer=None, owner_rec=None):
    """True if this process's gh identity is the repository owner."""
    v = viewer if viewer is not None else forge_viewer()
    rec = owner_rec if owner_rec is not None else repo_owner_record(repo)
    # Compare ids when both exist (login can be renamed or recycled).
    if v.get("id") is not None and rec.get("id") is not None:
        try:
            if int(v["id"]) == int(rec["id"]):
                return True
        except Exception:
            pass
    vl = (v.get("login") or "").strip().lower()
    ol = (rec.get("login") or "").strip().lower()
    return bool(vl) and bool(ol) and vl == ol


def enforce_live_identity(repo=None):
    """In live mode, refuse to stay live if gh is the repository owner.
    Path B peers must use a non-owner identity (docs Security / Path B
    identity). If no such identity exists on this host, force dry-run.
    """
    if mode() != "live":
        return "dry-run"
    repo = repo or env("SWARM_PIN_REPO", default_repo())
    try:
        if not runner_name_ok():
            force_dry_run("invalid SWARM_RUNNER %r (must match %s)" % (
                runner_name(), RUNNER_NAME_RE.pattern))
            return "dry-run"
        if viewer_is_repo_owner(repo):
            v = forge_viewer()
            force_dry_run(
                "gh identity %s is the repository owner; Path B runners must "
                "use a non-owner token (live claim/work/deliver refused)" % (
                    v.get("login") or "?"))
            return "dry-run"
    except ForgeError as e:
        force_dry_run("cannot verify gh identity; refusing live mode: " + str(e))
        return "dry-run"
    return "live"


def body_sha256(body):
    return hashlib.sha256((body or "").encode("utf-8")).hexdigest()


def _run_body_sha(first_line):
    m = re.search(r"(?i)\b(?:body-sha|sha256)=([0-9a-f]{64})\b", first_line or "")
    if m:
        return m.group(1).lower()
    m = re.search(r"(?i)\bsha256:([0-9a-f]{64})\b", first_line or "")
    if m:
        return m.group(1).lower()
    return ""


def _event_time(ev, field="created_at"):
    return parse_iso((ev or {}).get(field) or (ev or {}).get("createdAt") or "")


def snapshot_from_graphql(data):
    """Normalize a GraphQL repository payload for tests and evaluate_approval."""
    repo_obj = (data or {}).get("repository") or {}
    issue = repo_obj.get("issue") or {}
    owner = repo_obj.get("owner") or {}
    nodes = ((issue.get("timelineItems") or {}).get("nodes") or [])
    events, comments = [], []
    for node in nodes:
        typ = (node or {}).get("__typename") or ""
        if typ == "LabeledEvent":
            events.append({
                "event": "labeled",
                "created_at": node.get("createdAt"),
                "id": 0,
                "actor": node.get("actor") or {},
                "label": node.get("label") or {},
            })
        elif typ == "UnlabeledEvent":
            events.append({
                "event": "unlabeled",
                "created_at": node.get("createdAt"),
                "id": 0,
                "actor": node.get("actor") or {},
                "label": node.get("label") or {},
            })
        elif typ == "IssueComment":
            comments.append({
                "id": node.get("databaseId") or 0,
                "body": node.get("body") or "",
                "created_at": node.get("createdAt"),
                "updated_at": node.get("updatedAt") or node.get("createdAt"),
                "last_edited_at": node.get("lastEditedAt"),
                "user": node.get("author") or {},
            })
    body = issue.get("body") or ""
    return {
        "owner": {"login": owner.get("login"), "id": owner.get("databaseId") or owner.get("id"), "fetched": True},
        "number": issue.get("number"),
        "title": issue.get("title") or "",
        "body": body,
        "last_edited_at": parse_iso(issue.get("lastEditedAt") or ""),
        "events": events,
        "comments": comments,
        "body_sha": body_sha256(body),
        "truncated": False,
        "fetch_ok": True,
    }


def fetch_approval_snapshot(repo, number, max_pages=50):
    """One GraphQL query (paginated) for body, lastEditedAt and timeline."""
    owner, name = split_repo(repo)
    cursor = None
    nodes = []
    issue_meta = None
    owner_rec = None
    pages = 0
    while True:
        pages += 1
        if pages > max_pages:
            raise ForgeError("graphql timeline pagination cap hit for #%s" % number)
        data = gh_graphql(APPROVAL_GQL, {
            "owner": owner, "name": name, "number": int(number), "cursor": cursor,
        })
        repo_obj = (data or {}).get("repository") or {}
        if owner_rec is None:
            owner_rec = repo_obj.get("owner") or {}
        issue = repo_obj.get("issue")
        if not issue:
            raise ForgeError("graphql issue #%s not found" % number)
        if issue_meta is None:
            issue_meta = issue
        conn = issue.get("timelineItems") or {}
        batch = conn.get("nodes") or []
        nodes.extend(batch)
        page = conn.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        cursor = page.get("endCursor")
        if not cursor:
            raise ForgeError("graphql timeline missing endCursor for #%s" % number)
    events = []
    comments = []
    for node in nodes:
        typ = (node or {}).get("__typename") or ""
        if typ == "LabeledEvent":
            events.append({
                "event": "labeled",
                "created_at": node.get("createdAt"),
                "id": 0,
                "actor": node.get("actor") or {},
                "label": node.get("label") or {},
            })
        elif typ == "UnlabeledEvent":
            events.append({
                "event": "unlabeled",
                "created_at": node.get("createdAt"),
                "id": 0,
                "actor": node.get("actor") or {},
                "label": node.get("label") or {},
            })
        elif typ == "IssueComment":
            comments.append({
                "id": node.get("databaseId") or 0,
                "body": node.get("body") or "",
                "created_at": node.get("createdAt"),
                "updated_at": node.get("updatedAt") or node.get("createdAt"),
                "last_edited_at": node.get("lastEditedAt"),
                "user": node.get("author") or {},
            })
    return {
        "owner": {
            "login": (owner_rec or {}).get("login"),
            "id": (owner_rec or {}).get("databaseId") or (owner_rec or {}).get("id"),
            "fetched": True,
        },
        "number": (issue_meta or {}).get("number") or number,
        "title": (issue_meta or {}).get("title") or "",
        "body": (issue_meta or {}).get("body") or "",
        "last_edited_at": parse_iso((issue_meta or {}).get("lastEditedAt") or ""),
        "events": events,
        "comments": comments,
        "body_sha": body_sha256((issue_meta or {}).get("body") or ""),
        "truncated": False,
        "fetch_ok": True,
    }


class ApprovalResult(object):
    def __init__(self, ok, reason="", gate_at=None, body_sha="", body="",
                 last_edited_at=None, bound_sha="", truncated=False, fetch_ok=True):
        self.ok = bool(ok)
        self.reason = reason
        self.gate_at = gate_at
        self.body_sha = body_sha
        self.body = body
        self.last_edited_at = last_edited_at
        self.bound_sha = bound_sha
        self.truncated = truncated
        self.fetch_ok = fetch_ok


def _comment_first_line(comment):
    body = (comment or {}).get("body") or ""
    return body.lstrip().splitlines()[0].strip() if body.strip() else ""


def _comment_was_edited(comment):
    created = parse_iso((comment or {}).get("created_at") or (comment or {}).get("createdAt") or "")
    updated = parse_iso((comment or {}).get("updated_at") or (comment or {}).get("updatedAt") or "")
    edited = parse_iso((comment or {}).get("last_edited_at") or (comment or {}).get("lastEditedAt") or "")
    if edited:
        return True
    if created and updated and updated != created:
        return True
    return False


def evaluate_approval(repo, snapshot, owner_rec=None):
    """Pure approval decision from a snapshot (GraphQL shape or test fixture).

    A single time-ordered stream of label events and owner /run or /stop
    comments decides the current state. A later unlabeled event revokes
    an owner /run as well. Edited /run comments are ignored. lastEditedAt
    after gate_at, or a body-sha mismatch, invalidates approval.
    """
    if not snapshot or not snapshot.get("fetch_ok") or snapshot.get("truncated"):
        return ApprovalResult(False, reason="fetch-failed-or-truncated",
                              truncated=bool((snapshot or {}).get("truncated")),
                              fetch_ok=bool((snapshot or {}).get("fetch_ok")))
    rec = owner_rec or snapshot.get("owner") or repo_owner_record(repo, allow_fetch=False)
    labels = approval_labels()
    body = snapshot.get("body") or ""
    body_sha = snapshot.get("body_sha") or body_sha256(body)
    last_edited = snapshot.get("last_edited_at")
    if isinstance(last_edited, str):
        last_edited = parse_iso(last_edited)

    stream = []
    for ev in snapshot.get("events") or []:
        ev_name = (ev.get("event") or ev.get("__typename") or "")
        lname = ((ev.get("label") or {}).get("name") or "").lower()
        ts = _event_time(ev)
        eid = ev.get("id") or ev.get("databaseId") or 0
        if ev_name in ("labeled", "LabeledEvent") and lname in labels:
            stream.append((ts or datetime.min.replace(tzinfo=timezone.utc), eid, "label-add", ev))
        elif ev_name in ("unlabeled", "UnlabeledEvent") and lname in labels:
            stream.append((ts or datetime.min.replace(tzinfo=timezone.utc), eid, "label-del", ev))
    for c in snapshot.get("comments") or []:
        first = _comment_first_line(c)
        ts = parse_iso(c.get("created_at") or "") or datetime.min.replace(tzinfo=timezone.utc)
        cid = c.get("id") or c.get("databaseId") or 0
        if re.match(r"^/run(\s|$)", first) and is_repo_owner_actor(repo, c.get("user") or c.get("author") or {}, rec):
            if _comment_was_edited(c):
                continue
            stream.append((ts, cid, "run", c))
        elif re.match(r"^/stop(\s|$)", first) and is_repo_owner_actor(repo, c.get("user") or c.get("author") or {}, rec):
            stream.append((ts, cid, "stop", c))
    stream.sort(key=lambda t: (t[0], t[1], t[2]))

    approved = False
    gate_at = None
    bound_sha = ""
    for ts, eid, kind, obj in stream:
        if kind == "label-add":
            if is_repo_owner_actor(repo, obj.get("actor") or {}, rec):
                approved = True
                gate_at = ts
                bound_sha = ""
            else:
                approved = False
                gate_at = None
                bound_sha = ""
        elif kind in ("label-del", "stop"):
            approved = False
            gate_at = None
            bound_sha = ""
        elif kind == "run":
            approved = True
            gate_at = ts
            bound_sha = _run_body_sha(_comment_first_line(obj))

    if not approved:
        return ApprovalResult(False, reason="not-approved", body_sha=body_sha,
                              body=body, last_edited_at=last_edited, bound_sha=bound_sha)
    if last_edited and gate_at and last_edited > gate_at:
        return ApprovalResult(False, reason="body-edited-after-approval",
                              gate_at=gate_at, body_sha=body_sha, body=body,
                              last_edited_at=last_edited, bound_sha=bound_sha)
    if bound_sha and bound_sha != body_sha:
        return ApprovalResult(False, reason="body-sha-mismatch",
                              gate_at=gate_at, body_sha=body_sha, body=body,
                              last_edited_at=last_edited, bound_sha=bound_sha)
    return ApprovalResult(True, reason="approved", gate_at=gate_at, body_sha=body_sha,
                          body=body, last_edited_at=last_edited, bound_sha=bound_sha)


def issue_admin_approved(repo, issue, comments=None, events=None,
                         snapshot=None, last_edited_at=None):
    """True only with explicit repository-owner approval.

    Follows docs/swarm-worker-requirements.md:
    "Vetted issues, then explicit admin approval" and
    "Approval gates and interactive latency". Fetch errors and truncated
    timelines fail closed. Body binding uses GraphQL lastEditedAt plus a
    sha256 of the body (optional /run sha256:<hex>).
    """
    try:
        res = approval_status(repo, issue, comments=comments, events=events,
                              snapshot=snapshot, last_edited_at=last_edited_at)
        return res.ok
    except ForgeError as e:
        log("approval check failed closed: " + str(e))
        return False


def approval_status(repo, issue, comments=None, events=None,
                    snapshot=None, last_edited_at=None):
    if snapshot is None and events is None and comments is None:
        if isinstance(issue, dict):
            number = issue.get("number")
        else:
            number = issue
        if not number:
            return ApprovalResult(False, reason="no-number", fetch_ok=False)
        try:
            snapshot = fetch_approval_snapshot(repo, number)
        except ForgeError as e:
            log("approval snapshot for #%s: %s" % (number, e))
            return ApprovalResult(False, reason="fetch-error:" + str(e), fetch_ok=False)
    if snapshot is None:
        # Test / injected REST-shaped inputs. Body edits must be passed
        # as last_edited_at; the REST timeline does not emit them.
        if isinstance(issue, dict):
            number = issue.get("number")
            body = issue.get("body") or ""
            title = issue.get("title") or ""
        else:
            number = issue
            body, title = "", ""
        snapshot = {
            "owner": repo_owner_record(repo, allow_fetch=False),
            "number": number,
            "title": title,
            "body": body,
            "last_edited_at": last_edited_at,
            "events": events or [],
            "comments": comments or [],
            "body_sha": body_sha256(body),
            "truncated": False,
            "fetch_ok": True,
        }
    return evaluate_approval(repo, snapshot)


def known_runner_names():
    names = set(n.lower() for n in DEFAULT_PINS.keys())
    names.add(runner_name())
    names.update(x.strip().lower() for x in env("SWARM_RUNNERS", "").split(",") if x.strip())
    return names


def known_runner_logins():
    return set(x.strip().lower() for x in env("SWARM_RUNNER_LOGINS", "").split(",") if x.strip())


def comment_author_login(c):
    return ((c.get("user") or c.get("author") or {}).get("login") or "").strip()


def verifiable_runner_comment(comment, runner):
    """Claims/heartbeats count only from a known runner name and a real author."""
    if (runner or "").lower() not in known_runner_names():
        return False
    login = comment_author_login(comment)
    if not login:
        return False
    allowed = known_runner_logins()
    if allowed and login.lower() not in allowed:
        return False
    return True


def cap_lease(until, created, lease_h=None):
    """Cap lease-until at created + SWARM_LEASE_HOURS. None if unparseable."""
    if until is None:
        return None
    if created is None:
        created = datetime.now(timezone.utc)
    try:
        hours = float(lease_h if lease_h is not None else (env("SWARM_LEASE_HOURS", "2") or "2"))
    except Exception:
        hours = 2.0
    cap = created + timedelta(hours=hours)
    if until > cap:
        return cap
    return until


def unexpired_claims(issue, comments, now):
    labels = [lb.get("name", "") if isinstance(lb, dict) else str(lb)
              for lb in (issue.get("labels") or [])]
    claimed_runners = []
    for lab in labels:
        if lab.lower().startswith("claimed:"):
            claimed_runners.append(lab.split(":", 1)[1])
    entries = []
    for c in comments or []:
        body = c.get("body") or ""
        m = CLAIM_RE.search(body)
        if not m:
            continue
        if body.lstrip().lower().startswith("superseded"):
            continue
        runner, gen = m.group(1), int(m.group(2))
        if not verifiable_runner_comment(c, runner):
            continue
        created = parse_iso(c.get("created_at") or "")
        until = cap_lease(parse_iso(m.group(3)), created)
        if until is None:
            continue
        entries.append({
            "runner": runner,
            "gen": gen,
            "until": until,
            "created": created or datetime.now(timezone.utc),
            "id": c.get("id") or 0,
            "body": body,
            "comment": c,
            "author": comment_author_login(c),
        })
    for c in comments or []:
        body = c.get("body") or ""
        m = HEART_RE.search(body)
        if not m:
            continue
        runner, gen = m.group(1), int(m.group(2))
        hb_until = parse_iso(m.group(3))
        hb_created = parse_iso(c.get("created_at") or "")
        hb_until = cap_lease(hb_until, hb_created)
        if hb_until is None:
            continue
        author = comment_author_login(c)
        if not verifiable_runner_comment(c, runner):
            continue
        for e in entries:
            if e["runner"] == runner and e["gen"] == gen and e.get("author") == author:
                if hb_until > e["until"]:
                    e["until"] = hb_until
    live = []
    for e in entries:
        if e["body"].lstrip().lower().startswith("superseded"):
            continue
        if e["until"] is None or e["until"] <= now:
            continue
        live.append(e)
    # Lower comment id wins once both are visible.
    live.sort(key=lambda e: (e["id"], e["created"]))
    return live, claimed_runners


def next_gen(comments):
    g = 0
    for c in comments or []:
        body = c.get("body") or ""
        for rx in (CLAIM_RE, HEART_RE):
            m = rx.search(body)
            if m and verifiable_runner_comment(c, m.group(1)):
                g = max(g, int(m.group(2)))
    return g + 1


# ---- outbox -------------------------------------------------------------

def outbox_write(kind, payload):
    d = home_dir() / "outbox"
    d.mkdir(parents=True, exist_ok=True)
    name = "%s-%s-%s.json" % (iso_z(datetime.now(timezone.utc)).replace(":", ""), kind, os.getpid())
    path = d / name
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    log("outbox wrote " + str(path))
    return path


def issue_url(repo, number):
    return "https://github.com/%s/issues/%s" % (repo, number)


# ---- claim protocol -----------------------------------------------------

def get_issue(repo, number, uncached=False):
    owner, name = split_repo(repo)
    dt, status, obj, _ = gh_api("GET", "repos/%s/%s/issues/%s" % (owner, name, number), uncached=uncached)
    return dt, obj


def get_comments(repo, number, uncached=False):
    owner, name = split_repo(repo)
    path = "repos/%s/%s/issues/%s/comments?per_page=100" % (owner, name, number)
    dt, obj = gh_api_pages("GET", path, uncached=uncached)
    return dt, obj


def add_label(repo, number, label):
    owner, name = split_repo(repo)
    return gh_api("POST", "repos/%s/%s/issues/%s/labels" % (owner, name, number), data=[label])


def del_label(repo, number, label):
    owner, name = split_repo(repo)
    # label may contain :
    from urllib.parse import quote
    return gh_api("DELETE", "repos/%s/%s/issues/%s/labels/%s" % (owner, name, number, quote(label, safe="")))


def add_assignee(repo, number, login):
    owner, name = split_repo(repo)
    return gh_api("POST", "repos/%s/%s/issues/%s/assignees" % (owner, name, number), data={"assignees": [login]})


def del_assignee(repo, number, login):
    owner, name = split_repo(repo)
    return gh_api("DELETE", "repos/%s/%s/issues/%s/assignees" % (owner, name, number), data={"assignees": [login]})


def post_comment(repo, number, body):
    if mode() != "live":
        log("dry-run would comment on %s#%s" % (repo, number))
        return datetime.now(timezone.utc), 0, {"id": None, "dry": True}, ""
    if repo not in allowed_repos() and env("SWARM_PIN_REPO", default_repo()) != repo:
        raise ForgeError("refusing comment on %s: not in SWARM_REPOS" % repo)
    if note_has_identifying_fields(body or ""):
        raise ForgeError("refusing to post a comment that still has identifying stamp fields")
    owner, name = split_repo(repo)
    return gh_api("POST", "repos/%s/%s/issues/%s/comments" % (owner, name, number), data={"body": body})


def edit_comment(repo, comment_id, body):
    owner, name = split_repo(repo)
    return gh_api("PATCH", "repos/%s/%s/issues/comments/%s" % (owner, name, comment_id), data={"body": body})


def ensure_label(repo, label, color="fbca04", desc=""):
    owner, name = split_repo(repo)
    try:
        gh_api("POST", "repos/%s/%s/labels" % (owner, name), data={
            "name": label, "color": color, "description": desc[:100],
        })
    except ForgeError as e:
        if "already_exists" in str(e).lower() or "already exists" in str(e).lower() or "HTTP 422" in str(e):
            return
        # continue; adding to issue may still work if label exists
        log("ensure_label: " + str(e))


def claim_issue(repo, number):
    rn = runner_name()
    label = "claimed:" + rn
    owner_login = env("SWARM_OWNER", "brianreborn")
    lease_h = float(env("SWARM_LEASE_HOURS", "2") or "2")
    if not runner_name_ok(rn):
        raise ForgeError("invalid runner name %r" % rn)
    if mode() != "live":
        log("dry-run would claim %s#%s as %s" % (repo, number, rn))
        return {"ok": False, "dry": True, "number": number, "repo": repo}

    ensure_label(repo, label, desc="Path B lease held by runner " + rn)
    dt, issue = get_issue(repo, number, uncached=True)
    blocked = issue_blocked(repo, issue)
    if blocked:
        raise ForgeError("refusing to claim: " + blocked)
    st = approval_status(repo, issue)
    if not st.ok:
        raise NotApproved("refusing to claim: not owner-approved (%s)" % (st.reason or ""))
    dt2, comments = get_comments(repo, number, uncached=True)
    now = dt2 or dt
    live, _ = unexpired_claims(issue, comments, now)
    if live and live[0]["runner"] != rn:
        raise ForgeError("already held by %s gen %s" % (live[0]["runner"], live[0]["gen"]))
    if live and live[0]["runner"] == rn:
        log("already hold %s#%s gen %s" % (repo, number, live[0]["gen"]))
        return {"ok": True, "number": number, "repo": repo, "gen": live[0]["gen"],
                "comment_id": live[0]["id"], "until": iso_z(live[0]["until"]) if live[0]["until"] else "",
                "already": True}

    gen = next_gen(comments)
    until = now + timedelta(hours=lease_h)
    body = stamp_line() + "\n-- %s claim gen %s lease-until %s\n" % (rn, gen, iso_z(until))
    # assign + label + comment (GitHub is not CAS; re-read decides)
    try:
        add_assignee(repo, number, owner_login)
    except ForgeError as e:
        log("assign warning: " + str(e))
    try:
        add_label(repo, number, label)
    except ForgeError as e:
        log("label warning: " + str(e))
    dt3, st, cobj, _ = post_comment(repo, number, body)
    comment_id = cobj.get("id") if isinstance(cobj, dict) else None
    time.sleep(2.5)
    dt4, issue2 = get_issue(repo, number, uncached=True)
    dt5, comments2 = get_comments(repo, number, uncached=True)
    now2 = dt5 or dt4
    live2, _ = unexpired_claims(issue2, comments2, now2)
    if not live2:
        raise ForgeError("re-read found no live claim")
    winner = live2[0]
    if winner["runner"] != rn or winner["id"] != (comment_id or winner["id"]):
        log("lost race to %s gen %s; backing off" % (winner["runner"], winner["gen"]))
        try:
            if comment_id:
                newb = "SUPERSEDED lost-race\n" + body
                edit_comment(repo, comment_id, newb)
        except ForgeError as e:
            log("strike failed: " + str(e))
        try:
            del_label(repo, number, label)
        except ForgeError as e:
            log("del label failed: " + str(e))
        try:
            del_assignee(repo, number, owner_login)
        except ForgeError as e:
            log("unassign after lost race: " + str(e))
        return {"ok": False, "lost": True, "winner": winner["runner"], "number": number, "repo": repo}
    log("claimed %s#%s gen %s lease-until %s comment %s" % (repo, number, gen, iso_z(until), comment_id))
    return {"ok": True, "number": number, "repo": repo, "gen": gen,
            "comment_id": comment_id, "until": iso_z(until), "url": issue_url(repo, number)}


def release_issue(repo, number, reason="released"):
    rn = runner_name()
    label = "claimed:" + rn
    if mode() != "live":
        log("dry-run would release %s#%s" % (repo, number))
        return
    try:
        dt, comments = get_comments(repo, number, uncached=True)
        for c in comments:
            body = c.get("body") or ""
            m = CLAIM_RE.search(body)
            if not m or body.lstrip().lower().startswith("superseded"):
                continue
            if m.group(1) != rn:
                continue
            edit_comment(repo, c["id"], "SUPERSEDED %s\n%s" % (reason, body))
    except ForgeError as e:
        log("release comment: " + str(e))
    try:
        del_label(repo, number, label)
    except ForgeError as e:
        log("release label: " + str(e))
    try:
        del_assignee(repo, number, env("SWARM_OWNER", "brianreborn"))
