class PhoneLock(object):
    """flock on ~/.cache/familia-a57-ci.lock, the same per-phone lock the
    #367 a57-ssh-smoke REMOTE_SMOKE takes. Held only for one job step so the
    smoke sees 'busy' at most for the length of one job."""

    def __init__(self, wait_s=None):
        self.fd = None
        self.wait_s = float(env("SWARM_JOB_LOCK_WAIT_SEC", "300") if wait_s is None else wait_s)
        self.path = Path(env("SWARM_JOB_LOCK", str(Path.home() / ".cache" / "familia-a57-ci.lock")))

    def __enter__(self):
        import fcntl
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        fd = os.open(str(self.path), os.O_CREAT | os.O_RDWR, 0o600)
        try:
            os.fchmod(fd, 0o600)
        except OSError:
            pass
        deadline = time.time() + max(0.0, self.wait_s)
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.fd = fd
                log("job lock held " + str(self.path))
                return self
            except (BlockingIOError, OSError):
                if time.time() >= deadline:
                    os.close(fd)
                    raise ForgeError("job lock busy (a57 smoke or another job)")
                time.sleep(5)

    def __exit__(self, *exc):
        import fcntl
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
                self.fd = None
            log("job lock released")
        return False


def model_key():
    for name in ("SWARM_MODEL_KEY", "FAMILIA_API_KEY", "LLAMA_API_KEY"):
        v = env(name)
        if v:
            return v.strip()
    cands = [env("SWARM_MODEL_KEY_FILE")] + [
        str(Path.home() / ".config" / "familia" / n)
        for n in ("api-key", "api_key", "llama-api-key", "model-api-key")
    ]
    for c in cands:
        if not c:
            continue
        p = Path(c).expanduser()
        try:
            st = p.stat()
            if stat.S_IMODE(st.st_mode) & 0o077:
                log("model key file %s not 0600; ignoring" % p)
                continue
            for line in p.read_text().splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    return line
        except Exception:
            continue
    return ""


def model_http(url, prompt, max_tokens):
    import urllib.request
    import urllib.error
    body = json.dumps({
        "model": env("SWARM_MODEL_NAME", "local"),
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
        "temperature": 0.3,
    }).encode("utf-8")
    key = ""
    for attempt in (1, 2):
        req = urllib.request.Request(url.rstrip("/") + "/v1/chat/completions", data=body,
                                     headers={"Content-Type": "application/json"})
        if key:
            req.add_header("Authorization", "Bearer " + key)
        try:
            with urllib.request.urlopen(req, timeout=int(env("SWARM_MODEL_TIMEOUT", "900"))) as r:
                obj = json.loads(r.read().decode("utf-8", "replace"))
            return obj["choices"][0]["message"]["content"]
        except urllib.error.HTTPError as e:
            if e.code == 401 and attempt == 1:
                key = model_key()
                if key:
                    log("model endpoint 401; retrying with key from env/0600 file")
                    continue
            raise ForgeError("model http %s" % e.code)
        except (urllib.error.URLError, socket.timeout, TimeoutError, ConnectionError) as e:
            raise ForgeError("model http unreachable/timeout: %s" % type(e).__name__)
    raise ForgeError("model http failed")


def model_cli(gguf, prompt, max_tokens):
    exe = env("SWARM_LLAMA_BIN") or which("llama-completion") or which("llama-cli")
    if not exe:
        raise ForgeError("no llama-completion/llama-cli")
    # Pass the prompt via a mode-0600 temp file, not argv (/proc cmdline).
    fd, tmp = tempfile.mkstemp(prefix="swarm-prompt-", dir=str(home_dir()))
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, (prompt or "").encode("utf-8"))
        os.close(fd)
        fd = None
        argv = [exe, "-m", gguf, "-f", tmp, "-n", str(max_tokens), "-c", "4096",
                "-t", env("SWARM_MODEL_THREADS", "3"), "--temp", "0.3", "-no-cnv",
                "--no-display-prompt"]
        rc, out, err = run_cmd(argv, timeout=int(env("SWARM_MODEL_TIMEOUT", "900")))
        if rc != 0 and not out.strip():
            argv = [exe, "-m", gguf, "-f", tmp, "-n", str(max_tokens), "-t",
                    env("SWARM_MODEL_THREADS", "3")]
            rc, out, err = run_cmd(argv, timeout=int(env("SWARM_MODEL_TIMEOUT", "900")))
        if not out.strip():
            raise ForgeError("llama cli rc=%s %s" % (rc, cap_text(err, 300)))
        if out.startswith(prompt):
            out = out[len(prompt):]
        return out
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except Exception:
                pass
        try:
            os.unlink(tmp)
        except Exception:
            pass


def model_draft(prompt, max_tokens=700):
    """Local open model only. HTTP to a localhost endpoint (SWARM_MODEL_URL)
    or a one-shot llama-completion on SWARM_MODEL_GGUF (no listener)."""
    url = env("SWARM_MODEL_URL")
    gguf = env("SWARM_MODEL_GGUF")
    t0 = time.time()
    if url:
        if not re.match(r"^https?://(127\.0\.0\.1|localhost)(:\d+)?/?$", url):
            raise ForgeError("SWARM_MODEL_URL must be localhost")
        log("model draft via %s (max_tokens=%s)" % (url, max_tokens))
        try:
            txt = model_http(url, prompt, max_tokens)
            how = "http " + url
        except Exception as e:
            if not gguf:
                raise
            log("model http failed (%s); falling back to llama cli" % e)
            txt = model_cli(gguf, prompt, max_tokens)
            how = "llama-cli " + os.path.basename(gguf)
    elif gguf:
        log("model draft via llama cli %s (max_tokens=%s)" % (os.path.basename(gguf), max_tokens))
        txt = model_cli(gguf, prompt, max_tokens)
        how = "llama-cli " + os.path.basename(gguf)
    else:
        raise ForgeError("no local model configured (SWARM_MODEL_URL or SWARM_MODEL_GGUF)")
    log("model draft done in %ss (%s chars)" % (int(time.time() - t0), len(txt)))
    txt = re.sub(r"\s*\[end of text\]\s*$", "", txt.strip())
    return redact(txt).strip() + "\n", how


def git(args, cwd, timeout=180):
    rc, out, err = run_cmd(["git"] + args, timeout=timeout, cwd=str(cwd))
    if rc != 0:
        raise ForgeError("git %s rc=%s: %s" % (args[0], rc, cap_text(err.strip(), 400)))
    return out


