def _fsync_dir(d):
    try:
        fd = os.open(str(d), os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def _read_json_file(p):
    """Parsed JSON, or raise. Refuses a symlink."""
    p = Path(p)
    if os.path.islink(str(p)):
        raise ValueError("refusing symlink %s" % p)
    return json.loads(p.read_text())


def atomic_write_json(path, obj):
    """Write JSON atomically: temp file in the same dir (0600, O_EXCL),
    fsync, keep the previous good file as <name>.bak, os.replace, fsync
    the dir. A crash or full disk leaves the old file or the .bak intact."""
    path = Path(path)
    data = (json.dumps(obj, indent=2, sort_keys=True) + "\n").encode()
    tmp = path.with_name(".%s.%s.%s.tmp" % (path.name, os.getpid(), secrets.token_hex(4)))
    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        if path.exists() and not os.path.islink(str(path)):
            try:
                _read_json_file(path)
                good = True
            except Exception:
                good = False  # never let a corrupt file replace a good .bak
            if good:
                bak = path.with_name(path.name + ".bak")
                btmp = path.with_name(".%s.bak.%s.tmp" % (path.name, secrets.token_hex(4)))
                bfd = os.open(str(btmp), os.O_WRONLY | os.O_CREAT | os.O_EXCL
                              | getattr(os, "O_NOFOLLOW", 0), 0o600)
                with os.fdopen(bfd, "wb") as f:
                    f.write(path.read_bytes())
                    f.flush()
                    os.fsync(f.fileno())
                os.replace(str(btmp), str(bak))
        os.replace(str(tmp), str(path))
        _fsync_dir(path.parent)
    finally:
        try:
            if tmp.exists():
                tmp.unlink()
        except OSError:
            pass


def load_json_safe(path, what):
    """Load JSON; on a missing file return None. On a corrupt file log
    loudly and fall back to <name>.bak; if that fails too, return None
    (callers start empty) and leave both files for an operator."""
    path = Path(path)
    bak = path.with_name(path.name + ".bak")
    if not path.exists() and not os.path.islink(str(path)):
        return None
    try:
        return _read_json_file(path)
    except Exception as e:
        log("CORRUPT %s %s: %s; trying %s" % (what, path, e, bak.name))
    try:
        obj = _read_json_file(bak)
        log("CORRUPT %s: recovered from %s" % (what, bak))
        return obj
    except Exception as e:
        log("CORRUPT %s: backup unusable too (%s); starting empty, files kept" % (what, e))
        return None


def save_state(obj):
    atomic_write_json(state_path(), obj)


def load_state():
    obj = load_json_safe(state_path(), "state")
    return obj if isinstance(obj, dict) else {}


