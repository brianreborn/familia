def cmd_once():
    repo = env("SWARM_PIN_REPO", default_repo())
    number = pin_issue()
    if not number:
        log("no pin and no default; nothing to do")
        return 1
    result = {"repo": repo, "number": number, "runner": runner_name()}
    try:
        claim = claim_issue(repo, number)
        result["claim"] = claim
        if not claim.get("ok") and claim.get("lost"):
            save_state(result)
            return 2
        if not claim.get("ok"):
            save_state(result)
            return 2
        gen = claim.get("gen")
        work = work_issue(repo, number, gen=gen, claim=claim)
        result["work"] = work
        result["url"] = issue_url(repo, number)
        save_state(result)
        return 0 if work.get("path") else 1
    except NotApproved as e:
        log("not approved: " + str(e))
        result["error"] = str(e)
        # Local probe only. Nothing is posted or written to the outbox (B4).
        work = work_issue(repo, number, force_dry=True)
        result["work"] = work
        save_state(result)
        return 3
    except ForgeError as e:
        log("claim/forge failed: " + str(e))
        result["error"] = str(e)
        work = work_issue(repo, number, force_dry=True)
        result["work"] = work
        outbox_write("claim-failed", result)
        save_state(result)
        return 3


