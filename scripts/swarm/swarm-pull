def work_issue(repo, number, gen=None, force_dry=False, claim=None):
    """Write a local probe report. Post to the forge only when we still
    hold a claim and the owner-approval gate passes. force_dry writes
    locally only and never posts or enqueues a comment (B2, S10).
    """
    log("working %s#%s" % (repo, number))
    fn = PROBES.get(int(number)) if repo.endswith("/familia") else None
    if fn is None:
        report = (
            stamp_line()
            + "\n\nNo specialized probe for this issue. Recorded claim and stopped\n"
            "after identity stamp. A follow-up worker can implement the body.\n"
        )
    else:
        try:
            report = fn()
        except Exception:
            report = stamp_line() + "\n\nProbe failed:\n\n" + redact(traceback.format_exc())
    report = ascii_clean(report)
    if not report.endswith("\n"):
        report += "\n"
    work = home_dir() / "work" / repo.replace("/", "_") / str(number)
    work.mkdir(parents=True, exist_ok=True)
    path = work / "report.md"
    path.write_text(report)
    log("wrote report " + str(path) + " (%s bytes)" % path.stat().st_size)
    comment = (
        stamp_line()
        + "\nWorking this issue (read-only probe / design first pass).\n"
        + ("gen %s\n" % gen if gen else "")
        + "Full ASCII report follows.\n\n"
        + report
    )
    if len(comment) > 60000:
        comment = comment[:60000] + "\n... [truncated for GitHub comment cap]\n"
    can_post = (
        (not force_dry)
        and mode() == "live"
        and isinstance(claim, dict)
        and claim.get("ok")
    )
    if can_post:
        try:
            _, held = get_issue(repo, number, uncached=True)
            if not issue_admin_approved(repo, held):
                can_post = False
                log("approval gate failed; not posting on %s#%s" % (repo, number))
        except ForgeError as e:
            can_post = False
            log("approval re-check failed; not posting on %s#%s: %s" % (repo, number, e))
    if not can_post:
        log("local-only work on %s#%s (no post: dry, no held claim, or not owner-approved)" % (repo, number))
        return {"ok": True, "dry": True, "path": str(path), "posted": False}
    try:
        dt, st, obj, _ = post_comment(repo, number, comment)
        cid = obj.get("id") if isinstance(obj, dict) else None
        url = obj.get("html_url") if isinstance(obj, dict) else None
        log("posted report comment %s %s" % (cid, url or ""))
        return {"ok": True, "path": str(path), "comment_id": cid, "comment_url": url, "posted": True}
    except ForgeError as e:
        log("forge comment failed, saving outbox: " + str(e))
        p = outbox_write("comment", {
            "repo": repo, "number": number, "body": comment, "error": str(e),
        })
        return {"ok": False, "outbox": str(p), "path": str(path), "error": str(e)}


