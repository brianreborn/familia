def excluded_ids(repo):
    owner, name = split_repo(repo)
    if name == "familia" and owner == "brianreborn":
        return set(FAMILIA_EXCLUDED)
    return set()


def issue_blocked(repo, issue):
    n = issue.get("number")
    if n in excluded_ids(repo):
        return "excluded-id"
    labels = [lb.get("name", "") if isinstance(lb, dict) else str(lb)
              for lb in (issue.get("labels") or [])]
    low = [x.lower() for x in labels]
    for lab in low:
        if lab in BLOCK_LABELS or lab.startswith("needs-brian") or "security" in lab:
            return "block-label:" + lab
    title = issue.get("title") or ""
    body = issue.get("body") or ""
    if env("SWARM_HOT_FREEZE", "0") == "1" and (FREEZE_RE.search(title) or FREEZE_RE.search(body)):
        return "hot-freeze"
    if issue.get("pull_request"):
        return "is-pr"
    return ""


# Admin intake gate: docs/swarm-worker-requirements.md, section
# "Vetted issues, then explicit admin approval" (Coordinator-free pull
# swarm). An issue is not runnable just because it exists. Claiming and
# running wait on Brian's explicit admin approval (repository owner, not
# a bot or a shared peer identity). Discovery may stay open and parallel.
DEFAULT_APPROVAL_LABELS = ("swarm-approved",)
_OWNER_CACHE = {}
APPROVAL_GQL = """
query($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    owner {
      login
      __typename
      ... on User { databaseId }
      ... on Organization { databaseId }
    }
    issue(number: $number) {
      number
      title
      body
      lastEditedAt
      createdAt
      updatedAt
      timelineItems(first: 100, after: $cursor,
        itemTypes: [LABELED_EVENT, UNLABELED_EVENT, ISSUE_COMMENT,
                    RENAMED_TITLE_EVENT]) {
        pageInfo { hasNextPage endCursor }
        nodes {
          __typename
          ... on LabeledEvent {
            createdAt
            actor { ...ActorIds }
            label { name }
          }
          ... on UnlabeledEvent {
            createdAt
            actor { ...ActorIds }
            label { name }
          }
          ... on RenamedTitleEvent {
            createdAt
            actor { ...ActorIds }
          }
          ... on IssueComment {
            createdAt
            updatedAt
            lastEditedAt
            databaseId
            body
            author { ...ActorIds }
          }
        }
      }
    }
  }
}

fragment ActorIds on Actor {
  login
  __typename
  ... on User { databaseId }
  ... on Bot { databaseId }
  ... on Organization { databaseId }
  ... on Mannequin { databaseId }
}
"""


def approval_labels():
    raw = env("SWARM_APPROVAL_LABELS", ",".join(DEFAULT_APPROVAL_LABELS))
    return tuple(x.strip().lower() for x in raw.split(",") if x.strip())


def allowed_repos():
    raw = env("SWARM_REPOS", env("SWARM_PIN_REPO", default_repo()))
    return set(x.strip() for x in raw.split(",") if x.strip())


def _actor_from(obj):
    if not isinstance(obj, dict):
        return {}
    if "login" in obj or "type" in obj or "databaseId" in obj or "id" in obj:
        return obj
    return obj.get("actor") or obj.get("user") or obj.get("author") or {}


def actor_login(obj):
    return (_actor_from(obj).get("login") or "").strip()


def actor_id(obj):
    src = _actor_from(obj)
    return src.get("databaseId") or src.get("id")


def actor_is_bot(obj):
    src = _actor_from(obj)
    typ = (src.get("type") or src.get("__typename") or "").lower()
    login = (src.get("login") or "").lower()
    return typ == "bot" or typ.endswith("bot") or login.endswith("[bot]")


def repo_owner_record(repo, allow_fetch=True):
    """Repository owner {login, id}. Fetch errors are not cached as a fallback."""
    if repo in _OWNER_CACHE:
        return _OWNER_CACHE[repo]
    owner, name = split_repo(repo)
    # Not-fetched fallback is the repo path's owner segment, never env
    # (Race N3, Boundary R2). It is marked fetched=False, and live mode
    # refuses to run on it.
    fallback_login = owner or ""
    rec = {"login": fallback_login, "id": None, "fetched": False}
    if allow_fetch:
        try:
            _, _, obj, _ = gh_api("GET", "repos/%s/%s" % (owner, name))
            ow = (obj or {}).get("owner") or {}
            rec = {
                "login": ow.get("login") or fallback_login,
                "id": ow.get("id"),
                "fetched": True,
            }
            _OWNER_CACHE[repo] = rec
        except ForgeError:
            # Do not cache a fallback as if it were the forge owner.
            return rec
    return rec


def repo_owner_login(repo):
    """Repository owner login from the forge API only ("" if it could not be
    fetched). SWARM_OWNER is only an assertion checked against this value
    in enforce_live_identity; it never decides anything (Race N3)."""
    rec = repo_owner_record(repo)
    if not rec.get("fetched"):
        return ""
    return rec.get("login") or ""


def is_repo_owner_actor(repo, actor_obj, owner_rec=None):
    if actor_is_bot(actor_obj):
        return False
    rec = owner_rec or repo_owner_record(repo)
    if isinstance(rec, str):
        rec = {"login": rec, "id": None}
    rec = rec or {}
    aid = actor_id(actor_obj)
    oid = rec.get("id")
    if aid is not None and oid is not None:
        try:
            return int(aid) == int(oid)
        except Exception:
            pass
    login = actor_login(actor_obj)
    owner = rec.get("login") or ""
    return bool(login) and bool(owner) and login.lower() == owner.lower()


def forge_viewer(allow_fetch=True):
    if _VIEWER_CACHE:
        return _VIEWER_CACHE
    if not allow_fetch:
        return {"login": "", "id": None}
    _, _, obj, _ = gh_api("GET", "user")
    rec = {
        "login": ((obj or {}).get("login") or "").strip(),
        "id": (obj or {}).get("id"),
        "type": (obj or {}).get("type"),
    }
    _VIEWER_CACHE.update(rec)
    return rec


def viewer_is_repo_owner(repo, viewer=None, owner_rec=None):
    """True if this process's gh identity is the repository owner."""
    v = viewer if viewer is not None else forge_viewer()
    rec = owner_rec if owner_rec is not None else repo_owner_record(repo)
    # Compare ids when both exist (login can be renamed or recycled).
    if v.get("id") is not None and rec.get("id") is not None:
        try:
            if int(v["id"]) == int(rec["id"]):
                return True
        except Exception:
            pass
    vl = (v.get("login") or "").strip().lower()
    ol = (rec.get("login") or "").strip().lower()
    return bool(vl) and bool(ol) and vl == ol


def enforce_live_identity(repo=None):
    """In live mode, refuse to stay live if gh is the repository owner.
    Path B peers must use a non-owner identity (docs Security / Path B
    identity). If no such identity exists on this host, force dry-run.
    """
    if mode() != "live":
        return "dry-run"
    repo = repo or env("SWARM_PIN_REPO", default_repo())
    try:
        if not runner_name_ok():
            force_dry_run("invalid SWARM_RUNNER %r (must match %s)" % (
                runner_name(), RUNNER_NAME_RE.pattern))
            return "dry-run"
        # Boundary R2 / Race N3: the live decision uses only the API owner.
        rec = repo_owner_record(repo)
        if not rec.get("fetched") or not (rec.get("login") or "").strip():
            force_dry_run("repository owner not fetched from the forge API; refusing live mode")
            return "dry-run"
        asserted = (env("SWARM_OWNER", "") or "").strip().lower()
        if asserted and asserted != (rec.get("login") or "").strip().lower():
            force_dry_run("SWARM_OWNER %s does not match API owner %s" % (
                asserted, rec.get("login")))
            return "dry-run"
        v = forge_viewer()
        if not (v.get("login") or "").strip() or v.get("id") is None:
            force_dry_run("gh viewer login or id missing; refusing live mode")
            return "dry-run"
        logins = known_runner_logins()
        if not logins:
            # Race B3 / NB2: without an author allowlist anyone could post
            # claims under a runner name. Fail closed.
            force_dry_run("SWARM_RUNNER_LOGINS is unset; live mode needs the runner login allowlist")
            return "dry-run"
        if v["login"].strip().lower() not in logins:
            force_dry_run("gh viewer %s is not in SWARM_RUNNER_LOGINS" % v.get("login"))
            return "dry-run"
        if (rec.get("login") or "").strip().lower() in logins:
            # Boundary L1: the owner's comments must never count as claims.
            force_dry_run("SWARM_RUNNER_LOGINS lists the repository owner %s; remove it" % rec.get("login"))
            return "dry-run"
        if str(v.get("type") or "").lower() == "bot" or v["login"].lower().endswith("[bot]"):
            # Race R11: bot authors never count as claims, so a bot viewer
            # could never see its own claim. Refuse live instead.
            force_dry_run("gh viewer %s is a bot/App identity; runners need a user token" % v.get("login"))
            return "dry-run"
        if viewer_is_repo_owner(repo, viewer=v, owner_rec=rec):
            v = forge_viewer()
            force_dry_run(
                "gh identity %s is the repository owner; Path B runners must "
                "use a non-owner token (live claim/work/deliver refused)" % (
                    v.get("login") or "?"))
            return "dry-run"
    except ForgeError as e:
        force_dry_run("cannot verify gh identity; refusing live mode: " + str(e))
        return "dry-run"
    return "live"


def body_sha256(body):
    return hashlib.sha256((body or "").encode("utf-8")).hexdigest()


def content_sha256(title, body):
    """Hash of title plus body: what the prompt and doc are built from
    (Race R1). A title rename changes it."""
    blob = "title:" + (title or "") + "\n\nbody:\n" + (body or "")
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def _run_body_sha(first_line):
    m = re.search(r"(?i)\b(?:body-sha|sha256)=([0-9a-f]{64})\b", first_line or "")
    if m:
        return m.group(1).lower()
    m = re.search(r"(?i)\bsha256:([0-9a-f]{64})\b", first_line or "")
    if m:
        return m.group(1).lower()
    return ""


def _event_time(ev, field="created_at"):
    return parse_iso((ev or {}).get(field) or (ev or {}).get("createdAt") or "")


def _normalize_timeline(nodes):
    """Turn GraphQL timeline nodes into events/comments. Every item keeps
    its node index ("seq") so equal-second items keep the forge order
    (Race R3)."""
    events, comments = [], []
    for idx, node in enumerate(nodes or []):
        node = node or {}
        typ = node.get("__typename") or ""
        if typ in ("LabeledEvent", "UnlabeledEvent"):
            events.append({
                "event": "labeled" if typ == "LabeledEvent" else "unlabeled",
                "created_at": node.get("createdAt"),
                "seq": idx + 1,
                "actor": node.get("actor") or {},
                "label": node.get("label") or {},
            })
        elif typ == "RenamedTitleEvent":
            events.append({
                "event": "renamed",
                "created_at": node.get("createdAt"),
                "seq": idx + 1,
                "actor": node.get("actor") or {},
            })
        elif typ == "IssueComment":
            comments.append({
                "id": node.get("databaseId") or 0,
                "seq": idx + 1,
                "body": node.get("body") or "",
                "created_at": node.get("createdAt"),
                "updated_at": node.get("updatedAt") or node.get("createdAt"),
                "last_edited_at": node.get("lastEditedAt"),
                "user": node.get("author") or {},
            })
    return events, comments


def _snapshot(owner_rec, issue_meta, nodes, number=None):
    owner_rec = owner_rec or {}
    issue_meta = issue_meta or {}
    events, comments = _normalize_timeline(nodes)
    title = issue_meta.get("title") or ""
    body = issue_meta.get("body") or ""
    return {
        "owner": {
            "login": owner_rec.get("login"),
            "id": owner_rec.get("databaseId") or owner_rec.get("id"),
            "fetched": True,
        },
        "number": issue_meta.get("number") or number,
        "title": title,
        "body": body,
        "last_edited_at": parse_iso(issue_meta.get("lastEditedAt") or ""),
        "events": events,
        "comments": comments,
        "body_sha": body_sha256(body),
        "content_sha": content_sha256(title, body),
        "truncated": False,
        "fetch_ok": True,
    }


def snapshot_from_graphql(data):
    """Normalize a GraphQL repository payload for tests and evaluate_approval."""
    if isinstance(data, dict) and "data" in data and "repository" not in data:
        data = data.get("data") or {}
    repo_obj = (data or {}).get("repository") or {}
    issue = repo_obj.get("issue") or {}
    nodes = ((issue.get("timelineItems") or {}).get("nodes") or [])
    return _snapshot(repo_obj.get("owner") or {}, issue, nodes)


def fetch_approval_snapshot(repo, number, max_pages=50):
    """One GraphQL query (paginated) for title, body, lastEditedAt and timeline."""
    owner, name = split_repo(repo)
    cursor = None
    nodes = []
    issue_meta = None
    owner_rec = None
    pages = 0
    while True:
        pages += 1
        if pages > max_pages:
            raise ForgeError("graphql timeline pagination cap hit for #%s" % number)
        data = gh_graphql(APPROVAL_GQL, {
            "owner": owner, "name": name, "number": int(number), "cursor": cursor,
        })
        repo_obj = (data or {}).get("repository") or {}
        if owner_rec is None:
            owner_rec = repo_obj.get("owner") or {}
        issue = repo_obj.get("issue")
        if not issue:
            raise ForgeError("graphql issue #%s not found" % number)
        if issue_meta is None:
            issue_meta = issue
        conn = issue.get("timelineItems") or {}
        nodes.extend(conn.get("nodes") or [])
        page = conn.get("pageInfo") or {}
        if not page.get("hasNextPage"):
            break
        cursor = page.get("endCursor")
        if not cursor:
            raise ForgeError("graphql timeline missing endCursor for #%s" % number)
    return _snapshot(owner_rec, issue_meta, nodes, number=number)


class ApprovalResult(object):
    def __init__(self, ok, reason="", gate_at=None, body_sha="", body="",
                 last_edited_at=None, bound_sha="", truncated=False, fetch_ok=True,
                 title="", content_sha=""):
        self.ok = bool(ok)
        self.title = title
        self.content_sha = content_sha or content_sha256(title, body)
        self.reason = reason
        self.gate_at = gate_at
        self.body_sha = body_sha
        self.body = body
        self.last_edited_at = last_edited_at
        self.bound_sha = bound_sha
        self.truncated = truncated
        self.fetch_ok = fetch_ok


def _comment_first_line(comment):
    body = (comment or {}).get("body") or ""
    return body.lstrip().splitlines()[0].strip() if body.strip() else ""


def _comment_was_edited(comment):
    """Only a real body edit (lastEditedAt) counts (Race R7). updatedAt also
    moves for reactions and minimizing, which must not drop a valid /run."""
    edited = parse_iso((comment or {}).get("last_edited_at") or (comment or {}).get("lastEditedAt") or "")
    return bool(edited)


def evaluate_approval(repo, snapshot, owner_rec=None):
    """Pure approval decision from a snapshot (GraphQL shape or test fixture).

    A single time-ordered stream of label events and owner /run or /stop
    comments decides the current state. A later unlabeled event revokes
    an owner /run as well. Edited /run comments are ignored. lastEditedAt
    after gate_at, or a body-sha mismatch, invalidates approval.
    """
    if not snapshot or not snapshot.get("fetch_ok") or snapshot.get("truncated"):
        return ApprovalResult(False, reason="fetch-failed-or-truncated",
                              truncated=bool((snapshot or {}).get("truncated")),
                              fetch_ok=bool((snapshot or {}).get("fetch_ok")))
    rec = owner_rec or snapshot.get("owner") or repo_owner_record(repo, allow_fetch=False)
    labels = approval_labels()
    body = snapshot.get("body") or ""
    title = snapshot.get("title") or ""
    body_sha = snapshot.get("body_sha") or body_sha256(body)
    csha = snapshot.get("content_sha") or content_sha256(title, body)
    extra = {"title": title, "content_sha": csha}
    last_edited = snapshot.get("last_edited_at")
    if isinstance(last_edited, str):
        last_edited = parse_iso(last_edited)

    # Sort key: (time, grant=0 / revoke=1, timeline seq). Items in the same
    # second resolve toward revoke whatever their seq (Race R3); otherwise
    # the forge timeline order (node index) decides, not a fake id.
    tmin = datetime.min.replace(tzinfo=timezone.utc)
    stream = []
    for ev in snapshot.get("events") or []:
        ev_name = (ev.get("event") or ev.get("__typename") or "")
        lname = ((ev.get("label") or {}).get("name") or "").lower()
        ts = _event_time(ev) or tmin
        seq = ev.get("seq") or 0
        if ev_name in ("labeled", "LabeledEvent") and lname in labels:
            owner_add = is_repo_owner_actor(repo, ev.get("actor") or {}, rec)
            stream.append((ts, 0 if owner_add else 1, seq,
                           "label-add" if owner_add else "label-add-nonowner", ev))
        elif ev_name in ("unlabeled", "UnlabeledEvent") and lname in labels:
            stream.append((ts, 1, seq, "label-del", ev))
        elif ev_name in ("renamed", "RenamedTitleEvent"):
            # A title change after approval invalidates it (Race R1).
            stream.append((ts, 1, seq, "renamed", ev))
    for c in snapshot.get("comments") or []:
        first = _comment_first_line(c)
        ts = parse_iso(c.get("created_at") or "") or tmin
        seq = c.get("seq") or 0
        if re.match(r"^/run(\s|$)", first) and is_repo_owner_actor(repo, c.get("user") or c.get("author") or {}, rec):
            if _comment_was_edited(c):
                continue
            stream.append((ts, 0, seq, "run", c))
        elif re.match(r"^/stop(\s|$)", first) and is_repo_owner_actor(repo, c.get("user") or c.get("author") or {}, rec):
            stream.append((ts, 1, seq, "stop", c))
    stream.sort(key=lambda t: (t[0], t[1], t[2]))

    approved = False
    gate_at = None
    bound_sha = ""
    for ts, _prio, _seq, kind, obj in stream:
        if kind == "label-add":
            approved = True
            gate_at = ts
            bound_sha = ""
        elif kind in ("label-add-nonowner", "label-del", "stop", "renamed"):
            approved = False
            gate_at = None
            bound_sha = ""
        elif kind == "run":
            approved = True
            gate_at = ts
            bound_sha = _run_body_sha(_comment_first_line(obj))

    if not approved:
        return ApprovalResult(False, reason="not-approved", body_sha=body_sha,
                              body=body, last_edited_at=last_edited, bound_sha=bound_sha, **extra)
    # >= : an edit in the same second as the approval fails closed (Race R6).
    if last_edited and gate_at and last_edited >= gate_at:
        return ApprovalResult(False, reason="body-edited-after-approval",
                              gate_at=gate_at, body_sha=body_sha, body=body,
                              last_edited_at=last_edited, bound_sha=bound_sha, **extra)
    if bound_sha and bound_sha not in (body_sha, csha):
        return ApprovalResult(False, reason="body-sha-mismatch",
                              gate_at=gate_at, body_sha=body_sha, body=body,
                              last_edited_at=last_edited, bound_sha=bound_sha, **extra)
    return ApprovalResult(True, reason="approved", gate_at=gate_at, body_sha=body_sha,
                          body=body, last_edited_at=last_edited, bound_sha=bound_sha, **extra)


def issue_admin_approved(repo, issue, comments=None, events=None,
                         snapshot=None, last_edited_at=None):
    """True only with explicit repository-owner approval.

    Follows docs/swarm-worker-requirements.md:
    "Vetted issues, then explicit admin approval" and
    "Approval gates and interactive latency". Fetch errors and truncated
    timelines fail closed. Body binding uses GraphQL lastEditedAt plus a
    sha256 of the body (optional /run sha256:<hex>).
    """
    try:
        res = approval_status(repo, issue, comments=comments, events=events,
                              snapshot=snapshot, last_edited_at=last_edited_at)
        return res.ok
    except ForgeError as e:
        log("approval check failed closed: " + str(e))
        return False


def approval_status(repo, issue, comments=None, events=None,
                    snapshot=None, last_edited_at=None):
    if snapshot is None and events is None and comments is None:
        if isinstance(issue, dict):
            number = issue.get("number")
        else:
            number = issue
        if not number:
            return ApprovalResult(False, reason="no-number", fetch_ok=False)
        try:
            snapshot = fetch_approval_snapshot(repo, number)
        except ForgeError as e:
            log("approval snapshot for #%s: %s" % (number, e))
            return ApprovalResult(False, reason="fetch-error:" + str(e), fetch_ok=False)
    if snapshot is None:
        # Test / injected REST-shaped inputs. Body edits must be passed
        # as last_edited_at; the REST timeline does not emit them.
        if isinstance(issue, dict):
            number = issue.get("number")
            body = issue.get("body") or ""
            title = issue.get("title") or ""
        else:
            number = issue
            body, title = "", ""
        snapshot = {
            "owner": repo_owner_record(repo, allow_fetch=False),
            "number": number,
            "title": title,
            "body": body,
            "last_edited_at": last_edited_at,
            "events": events or [],
            "comments": comments or [],
            "body_sha": body_sha256(body),
            "content_sha": content_sha256(title, body),
            "truncated": False,
            "fetch_ok": True,
        }
    return evaluate_approval(repo, snapshot)


def known_runner_logins():
    return set(x.strip().lower() for x in env("SWARM_RUNNER_LOGINS", "").split(",") if x.strip())


def comment_author_login(c):
    return ((c.get("user") or c.get("author") or {}).get("login") or "").strip()


def verifiable_runner_comment(comment, runner):
    """A claim or heartbeat counts when it is well-formed and its author is
    an allowed runner login, whatever the runner name (Race NB2: unknown
    peers such as box, qodesh, shalom or note9 still block). With
    SWARM_RUNNER_LOGINS unset nothing counts (Race B3, fail closed); live
    mode is refused in that case by enforce_live_identity, so this only
    affects dry-run."""
    if not runner_name_ok((runner or "").lower()):
        return False
    login = comment_author_login(comment)
    if not login:
        return False
    if actor_is_bot(comment.get("user") or comment.get("author") or {}):
        return False
    allowed = known_runner_logins()
    if not allowed:
        return False
    if login.lower() in _known_owner_logins():
        # Boundary L1: an owner comment is never a runner claim.
        return False
    return login.lower() in allowed


def _known_owner_logins():
    out = set()
    for rec in _OWNER_CACHE.values():
        if isinstance(rec, dict) and rec.get("fetched") and rec.get("login"):
            out.add(rec["login"].strip().lower())
    return out


def cap_lease(until, created, lease_h=None):
    """Cap lease-until at created + SWARM_LEASE_HOURS. None if unparseable."""
    if until is None:
        return None
    if created is None:
        created = datetime.now(timezone.utc)
    try:
        hours = float(lease_h if lease_h is not None else (env("SWARM_LEASE_HOURS", "2") or "2"))
    except Exception:
        hours = 2.0
    cap = created + timedelta(hours=hours)
    if until > cap:
        return cap
    return until


def unexpired_claims(issue, comments, now):
    labels = [lb.get("name", "") if isinstance(lb, dict) else str(lb)
              for lb in (issue.get("labels") or [])]
    claimed_runners = []
    for lab in labels:
        if lab.lower().startswith("claimed:"):
            claimed_runners.append(lab.split(":", 1)[1])
    entries = []
    for c in comments or []:
        body = c.get("body") or ""
        m = CLAIM_RE.search(body)
        if not m:
            continue
        if body.lstrip().lower().startswith("superseded"):
            continue
        runner, gen = m.group(1), int(m.group(2))
        if not verifiable_runner_comment(c, runner):
            continue
        created = parse_iso(c.get("created_at") or "")
        until = cap_lease(parse_iso(m.group(3)), created)
        if until is None:
            continue
        entries.append({
            "runner": runner,
            "gen": gen,
            "until": until,
            "created": created or datetime.now(timezone.utc),
            "id": c.get("id") or 0,
            "body": body,
            "comment": c,
            "author": comment_author_login(c),
        })
    # Race H1: walk heartbeats in forge order. One extends a claim only if
    # GitHub created it before that claim's lease (as extended so far)
    # expired, so an expired chain stays dead and a late heartbeat cannot
    # take the issue back from a newer holder.
    hbs = []
    for c in comments or []:
        body = c.get("body") or ""
        m = HEART_RE.search(body)
        if not m:
            continue
        if body.lstrip().lower().startswith("superseded"):
            continue
        runner, gen = m.group(1), int(m.group(2))
        hb_created = parse_iso(c.get("created_at") or "")
        if hb_created is None:
            continue
        hb_until = cap_lease(parse_iso(m.group(3)), hb_created)
        if hb_until is None:
            continue
        if not verifiable_runner_comment(c, runner):
            continue
        hbs.append((hb_created, c.get("id") or 0, runner, gen, hb_until, comment_author_login(c)))
    hbs.sort(key=lambda t: (t[0], t[1]))
    for hb_created, _hid, runner, gen, hb_until, author in hbs:
        for e in entries:
            if e["runner"] == runner and e["gen"] == gen and e.get("author") == author:
                if e["until"] is None or hb_created < e["created"] or hb_created >= e["until"]:
                    continue
                if hb_until > e["until"]:
                    e["until"] = hb_until
    live = []
    for e in entries:
        if e["body"].lstrip().lower().startswith("superseded"):
            continue
        if e["until"] is None or e["until"] <= now:
            continue
        live.append(e)
    # Lower comment id wins once both are visible.
    live.sort(key=lambda e: (e["id"], e["created"]))
    return live, claimed_runners


def next_gen(comments):
    g = 0
    for c in comments or []:
        body = c.get("body") or ""
        for rx in (CLAIM_RE, HEART_RE):
            m = rx.search(body)
            if m and verifiable_runner_comment(c, m.group(1)):
                g = max(g, int(m.group(2)))
    return g + 1


# ---- outbox -------------------------------------------------------------

def private_dir(p):
    """mkdir + chmod 0700 (Boundary F2). Refuses a symlink (Boundary G1)."""
    p = Path(p)
    try:
        st = os.lstat(str(p))
        if stat.S_ISLNK(st.st_mode):
            raise ForgeError("refusing symlinked private dir %s" % p)
        if not stat.S_ISDIR(st.st_mode):
            raise ForgeError("refusing non-directory private dir %s" % p)
    except FileNotFoundError:
        p.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        os.chmod(str(p), 0o700, follow_symlinks=False)
    except (OSError, NotImplementedError):
        try:
            if not os.path.islink(str(p)):
                os.chmod(str(p), 0o700)
        except OSError:
            pass
    return p


def prune_dir(p, keep_days=None, keep_files=None, now=None):
    """Drop files older than SWARM_OUTBOX_KEEP_DAYS (30) and beyond the
    newest SWARM_OUTBOX_KEEP_FILES (500). Returns the number removed."""
    p = Path(p)
    if os.path.islink(str(p)) or not p.is_dir():
        return 0  # Boundary G1: never prune through a symlink
    try:
        days = float(keep_days if keep_days is not None else (env("SWARM_OUTBOX_KEEP_DAYS", "30") or "30"))
        count = int(keep_files if keep_files is not None else (env("SWARM_OUTBOX_KEEP_FILES", "500") or "500"))
    except Exception:
        days, count = 30.0, 500
    days = max(1.0, days)    # Boundary G2
    count = max(1, count)
    now = time.time() if now is None else now
    files = sorted((f for f in p.iterdir() if f.is_file() and not f.is_symlink()),
                   key=lambda f: f.lstat().st_mtime, reverse=True)
    removed = 0
    for i, f in enumerate(files):
        if i >= count or now - f.lstat().st_mtime > days * 86400:
            try:
                f.unlink()
                removed += 1
            except OSError:
                pass
    return removed


def outbox_write(kind, payload):
    d = private_dir(home_dir() / "outbox")
    name = "%s-%s-%s.json" % (iso_z(datetime.now(timezone.utc)).replace(":", ""), kind, os.getpid())
    path = d / name
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(path), flags, 0o600)
    except FileExistsError:
        path = d / ("%s-%s.json" % (path.stem, secrets.token_hex(4)))
        fd = os.open(str(path), flags, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    log("outbox wrote " + str(path))
    return path


def issue_url(repo, number):
    return "https://github.com/%s/issues/%s" % (repo, number)


# ---- claim protocol -----------------------------------------------------

def get_issue(repo, number, uncached=False):
    owner, name = split_repo(repo)
    dt, status, obj, _ = gh_api("GET", "repos/%s/%s/issues/%s" % (owner, name, number), uncached=uncached)
    return dt, obj


def get_comments(repo, number, uncached=False):
    owner, name = split_repo(repo)
    path = "repos/%s/%s/issues/%s/comments?per_page=100" % (owner, name, number)
    dt, obj = gh_api_pages("GET", path, uncached=uncached)
    return dt, obj


def add_label(repo, number, label):
    owner, name = split_repo(repo)
    return gh_api("POST", "repos/%s/%s/issues/%s/labels" % (owner, name, number), data=[label])


def del_label(repo, number, label):
    owner, name = split_repo(repo)
    # label may contain :
    from urllib.parse import quote
    return gh_api("DELETE", "repos/%s/%s/issues/%s/labels/%s" % (owner, name, number, quote(label, safe="")))


def add_assignee(repo, number, login):
    owner, name = split_repo(repo)
    return gh_api("POST", "repos/%s/%s/issues/%s/assignees" % (owner, name, number), data={"assignees": [login]})


def del_assignee(repo, number, login):
    owner, name = split_repo(repo)
    return gh_api("DELETE", "repos/%s/%s/issues/%s/assignees" % (owner, name, number), data={"assignees": [login]})


def post_comment(repo, number, body):
    if mode() != "live":
        log("dry-run would comment on %s#%s" % (repo, number))
        return datetime.now(timezone.utc), 0, {"id": None, "dry": True}, ""
    if repo not in allowed_repos() and env("SWARM_PIN_REPO", default_repo()) != repo:
        raise ForgeError("refusing comment on %s: not in SWARM_REPOS" % repo)
    if note_has_identifying_fields(body or ""):
        raise ForgeError("refusing to post a comment that still has identifying stamp fields")
    owner, name = split_repo(repo)
    path = "repos/%s/%s/issues/%s/comments" % (owner, name, number)
    try:
        return gh_api("POST", path, data={"body": body})
    except AmbiguousWrite as e:
        # Race R4: the POST may have landed. Look before any retry.
        log("ambiguous comment POST on %s#%s; checking before retry: %s" % (repo, number, e))
        time.sleep(float(env("SWARM_AMBIGUOUS_WAIT_SEC", "2") or "2"))
        found = _find_own_comment(repo, number, body)
        if found is not None:
            log("comment had landed (id %s); not reposting" % found.get("id"))
            return datetime.now(timezone.utc), 201, found, ""
        return gh_api("POST", path, data={"body": body})


def _find_own_comment(repo, number, body):
    """Newest comment on the issue by this viewer with exactly this body."""
    viewer = (forge_viewer().get("login") or "").lower()
    _, comments = get_comments(repo, number, uncached=True)
    for c in reversed(comments or []):
        if comment_author_login(c).lower() == viewer and (c.get("body") or "") == body:
            return c
    return None


def edit_comment(repo, comment_id, body):
    owner, name = split_repo(repo)
    path = "repos/%s/%s/issues/comments/%s" % (owner, name, comment_id)
    try:
        return gh_api("PATCH", path, data={"body": body})
    except AmbiguousWrite as e:
        log("ambiguous comment PATCH %s; checking before retry: %s" % (comment_id, e))
        dt, st, cur, raw = gh_api("GET", path, uncached=True)
        if isinstance(cur, dict) and (cur.get("body") or "") == body:
            log("edit had landed on %s; not re-sending" % comment_id)
            return dt, st, cur, raw
        return gh_api("PATCH", path, data={"body": body})


def ensure_label(repo, label, color="fbca04", desc=""):
    owner, name = split_repo(repo)
    try:
        gh_api("POST", "repos/%s/%s/labels" % (owner, name), data={
            "name": label, "color": color, "description": desc[:100],
        })
    except ForgeError as e:
        if "already_exists" in str(e).lower() or "already exists" in str(e).lower() or "HTTP 422" in str(e):
            return
        # continue; adding to issue may still work if label exists
        log("ensure_label: " + str(e))


def stale_claim_labels(issue, live, comments=None):
    """claimed:<runner> labels whose runner has a verifiable claim that has
    expired and no live one (Race R9). A label with no claim comment yet
    may be a peer's brand-new claim in flight, so it is left alone
    (Race R14)."""
    held = set(e["runner"].lower() for e in (live or []))
    claimed = set()
    for c in comments or []:
        m = CLAIM_RE.search(c.get("body") or "")
        if m and verifiable_runner_comment(c, m.group(1)):
            claimed.add(m.group(1).lower())
    out = []
    for lb in (issue or {}).get("labels") or []:
        name = lb.get("name", "") if isinstance(lb, dict) else str(lb)
        if not name.lower().startswith("claimed:"):
            continue
        who = name.split(":", 1)[1].lower()
        if who not in held and who in claimed:
            out.append(name)
    return out


def clear_stale_claim_labels(repo, number, issue, live, comments=None):
    for name in stale_claim_labels(issue, live, comments):
        try:
            del_label(repo, number, name)
            log("cleared stale label %s on #%s" % (name, number))
        except ForgeError as e:
            log("stale label %s on #%s not cleared: %s" % (name, number, e))


def _essential_claim(fn):
    return _essential(fn, kind="claim")


@_essential_claim
def claim_issue(repo, number):
    rn = runner_name()
    label = "claimed:" + rn
    lease_h = float(env("SWARM_LEASE_HOURS", "2") or "2")
    if not runner_name_ok(rn):
        raise ForgeError("invalid runner name %r" % rn)
    if mode() != "live":
        log("dry-run would claim %s#%s as %s" % (repo, number, rn))
        return {"ok": False, "dry": True, "number": number, "repo": repo}

    owner_login = repo_owner_login(repo)
    me = (forge_viewer().get("login") or "").lower()
    ensure_label(repo, label, desc="Path B lease held by runner " + rn)
    dt, issue = get_issue(repo, number, uncached=True)
    blocked = issue_blocked(repo, issue)
    if blocked:
        raise ForgeError("refusing to claim: " + blocked)
    st = approval_status(repo, issue)
    if not st.ok:
        raise NotApproved("refusing to claim: not owner-approved (%s)" % (st.reason or ""))
    dt2, comments = get_comments(repo, number, uncached=True)
    require_forge_clock("claim")
    now = dt2 or dt
    live, _ = unexpired_claims(issue, comments, now)
    mine = bool(live) and live[0]["runner"] == rn and (live[0].get("author") or "").lower() == me
    if live and not mine:
        raise ForgeError("already held by %s (%s) gen %s" % (
            live[0]["runner"], live[0].get("author") or "?", live[0]["gen"]))
    if mine:
        log("already hold %s#%s gen %s" % (repo, number, live[0]["gen"]))
        return {"ok": True, "number": number, "repo": repo, "gen": live[0]["gen"],
                "comment_id": live[0]["id"], "until": iso_z(live[0]["until"]) if live[0]["until"] else "",
                "already": True, "claimed_at": iso_z(live[0]["created"]), "idle_heartbeats": 0}

    clear_stale_claim_labels(repo, number, issue, live, comments)
    gen = next_gen(comments)
    until = now + timedelta(hours=lease_h)
    body = stamp_line() + "\n-- %s claim gen %s lease-until %s\n" % (rn, gen, iso_z(until))
    # assign + label + comment (GitHub is not CAS; re-read decides)
    assigned_owner = False
    already = [(a.get("login") or "").lower() for a in ((issue or {}).get("assignees") or [])]
    if owner_login and owner_login.lower() not in already:
        try:
            add_assignee(repo, number, owner_login)
            assigned_owner = True
        except ForgeError as e:
            log("assign warning: " + str(e))
    try:
        add_label(repo, number, label)
    except ForgeError as e:
        log("label warning: " + str(e))
    dt3, st, cobj, _ = post_comment(repo, number, body)
    comment_id = cobj.get("id") if isinstance(cobj, dict) else None
    time.sleep(2.5)
    dt4, issue2 = get_issue(repo, number, uncached=True)
    dt5, comments2 = get_comments(repo, number, uncached=True)
    now2 = dt5 or dt4
    live2, _ = unexpired_claims(issue2, comments2, now2)
    if not live2:
        raise ForgeError("re-read found no live claim")
    winner = live2[0]
    if (comment_id and winner["id"] != comment_id and winner["runner"] == rn
            and (winner.get("author") or "").lower() == me and winner["gen"] == gen):
        # Race R10: an ambiguous POST that landed twice. The lower copy is
        # still ours; adopt it and strike the duplicate.
        log("duplicate own claim %s/%s; keeping %s" % (winner["id"], comment_id, winner["id"]))
        try:
            edit_comment(repo, comment_id, "SUPERSEDED duplicate\n" + body)
        except ForgeError as e:
            log("strike duplicate failed: " + str(e))
        comment_id = winner["id"]
    if (winner["runner"] != rn or (winner.get("author") or "").lower() != me
            or winner["id"] != (comment_id or winner["id"])):
        log("lost race to %s gen %s; backing off" % (winner["runner"], winner["gen"]))
        try:
            if comment_id:
                newb = "SUPERSEDED lost-race\n" + body
                edit_comment(repo, comment_id, newb)
        except ForgeError as e:
            log("strike failed: " + str(e))
        try:
            del_label(repo, number, label)
        except ForgeError as e:
            log("del label failed: " + str(e))
        # Race R5: leave the owner assignee alone; the winner set it too.
        return {"ok": False, "lost": True, "winner": winner["runner"], "number": number, "repo": repo}
    log("claimed %s#%s gen %s lease-until %s comment %s" % (repo, number, gen, iso_z(until), comment_id))
    return {"ok": True, "number": number, "repo": repo, "gen": gen,
            "comment_id": comment_id, "until": iso_z(until), "url": issue_url(repo, number),
            "assigned_owner": assigned_owner, "claimed_at": iso_z(now), "idle_heartbeats": 0}


@_essential
def release_issue(repo, number, reason="released", claim=None):
    rn = runner_name()
    label = "claimed:" + rn
    if mode() != "live":
        log("dry-run would release %s#%s" % (repo, number))
        return
    me = (forge_viewer().get("login") or "").lower()
    try:
        dt, comments = get_comments(repo, number, uncached=True)
        for c in comments:
            body = c.get("body") or ""
            m = CLAIM_RE.search(body)
            if not m or body.lstrip().lower().startswith("superseded"):
                continue
            if m.group(1) != rn:
                continue
            if not me or comment_author_login(c).lower() != me:
                # Not ours: editing it would 403 (Race R4 example).
                continue
            edit_comment(repo, c["id"], "SUPERSEDED %s\n%s" % (reason, body))
    except ForgeError as e:
        log("release comment: " + str(e))
    try:
        del_label(repo, number, label)
    except ForgeError as e:
        log("release label: " + str(e))
    others_live = None
    try:
        _, issue = get_issue(repo, number, uncached=True)
        _, comments = get_comments(repo, number, uncached=True)
        require_forge_clock("stale-label sweep")
        live, _ = unexpired_claims(issue, comments, server_now())
        others_live = [x for x in live if not (x["runner"] == rn and (x.get("author") or "").lower() == me)]
        clear_stale_claim_labels(repo, number, issue, live, comments)
    except ForgeError as e:
        log("release stale-label sweep: " + str(e))
    # Race R13: unassign the owner only if this claim assigned them.
    # Boundary G5: and never while another live claim relies on it (or
    # when that could not be checked).
    owner_login = repo_owner_login(repo)
    if (owner_login and isinstance(claim, dict) and claim.get("assigned_owner")
            and others_live == []):
        try:
            del_assignee(repo, number, owner_login)
        except ForgeError as e:
            log("release unassign: " + str(e))
    log("released %s#%s (%s)" % (repo, number, reason))


class LeaseLost(ForgeError):
    """This host no longer holds the first live claim. Drop the claim and
    abort any job without pushing (Race H1)."""
    pass


def holds_first_live_claim(live, gen, claim=None):
    if not live:
        return False
    w = live[0]
    me = (forge_viewer().get("login") or "").lower()
    if w["runner"] != runner_name() or (w.get("author") or "").lower() != me:
        return False
    if gen is not None and int(w["gen"]) != int(gen):
        return False
    if claim and claim.get("comment_id") and w["id"] != claim.get("comment_id"):
        return False
    return True


@_essential
def heartbeat_issue(repo, number, gen, claim=None):
    """Re-read, and post a heartbeat only while this host still holds the
    earliest live claim at forge time. Raises LeaseLost otherwise."""
    rn = runner_name()
    lease_h = float(env("SWARM_LEASE_HOURS", "2") or "2")
    dt, issue = get_issue(repo, number, uncached=True)
    dt2, comments = get_comments(repo, number, uncached=True)
    require_forge_clock("heartbeat")
    now = dt2 or dt
    live, _ = unexpired_claims(issue, comments, now)
    if not holds_first_live_claim(live, gen, claim):
        holder = ("%s (%s) gen %s" % (live[0]["runner"], live[0].get("author") or "?", live[0]["gen"])
                  if live else "nobody")
        raise LeaseLost("lease on #%s gen %s lost; first live claim: %s" % (number, gen, holder))
    cur_until = live[0]["until"]
    until = now + timedelta(hours=lease_h)
    body = stamp_line() + "\n-- %s heartbeat gen %s lease-until %s\n" % (rn, gen, iso_z(until))
    _, _, obj, _ = post_comment(repo, number, body)
    # Race P2: readers count a heartbeat only if GitHub created it before
    # the lease expired. Trust it locally only on the same terms.
    created = parse_iso((obj or {}).get("created_at") or "") if isinstance(obj, dict) else None
    if created is None or cur_until is None or created >= cur_until:
        raise LeaseLost("heartbeat on #%s gen %s landed at %s, lease ended %s" % (
            number, gen, iso_z(created) if created else "?", iso_z(cur_until) if cur_until else "?"))
    until = min(until, cap_lease(until, created))
    log("heartbeat %s#%s gen %s until %s" % (repo, number, gen, iso_z(until)))
    return iso_z(until)


def require_lease(repo, number, claim):
    """Re-read and require this host still holds the first live claim
    (Race N8: between push and pr create). Raises LeaseLost."""
    if mode() != "live" or not claim:
        return
    dt, issue = get_issue(repo, number, uncached=True)
    dt2, comments = get_comments(repo, number, uncached=True)
    require_forge_clock("lease check")
    live, _ = unexpired_claims(issue, comments, dt2 or dt)
    if not holds_first_live_claim(live, claim.get("gen"), claim):
        raise LeaseLost("lease on #%s lost before pr create" % number)


