#!/bin/sh
# familia: the front door.
#   ./familia                         Charm/gum home (Talk to the protomodel first)
#   ./familia --legacy-menu | menu    old familia-menu.sh catalog (fallback only)
#   FAMILIA_LEGACY_MENU=1 ./familia   same legacy catalog
#   ./familia COMMAND [VALUE...]      CLI (same as before; scripts/cli-commands.txt)
#   ./familia --dry-run COMMAND ...   print the exact command, run nothing
#   ./familia help [COMMAND]          every command, or what one runs
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Charm gum often lives in ~/.local/bin on this box
PATH="${HOME:-}/.local/bin:${PATH:-}"
export PATH

while [ $# -gt 0 ]; do
  case "$1" in
    *=*)
      name=${1%%=*}
      case "$name" in ''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) break ;; esac
      export "$1"
      shift
      ;;
    *) break ;;
  esac
done

# No args → new gum home (unless legacy env override)
if [ $# -eq 0 ]; then
  if [ "${FAMILIA_LEGACY_MENU:-}" = 1 ]; then
    exec bash "$ROOT/familia-menu.sh"
  fi
  exec sh "$ROOT/scripts/familia_home.sh"
fi

# Explicit legacy / home switches before CLI resolve
case "$1" in
  --legacy-menu)
    shift
    exec bash "$ROOT/familia-menu.sh" "$@"
    ;;
  --home)
    shift
    exec sh "$ROOT/scripts/familia_home.sh" "$@"
    ;;
  menu)
    # keep `familia menu` as the documented legacy entry (also handled in --cli)
    shift
    exec bash "$ROOT/familia-menu.sh" "$@"
    ;;
  /?*)
    w=${1#/}; shift; set -- search "$w" "$@"
    ;;
esac

exec bash "$ROOT/familia-menu.sh" --cli "$@"
