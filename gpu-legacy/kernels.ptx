  ld.param.u64 %rd2, [pv];
  ld.param.u64 %rd3, [pxb];
  ld.param.u32 %r1, [phs];
  ld.param.u32 %r2, [pT];
  ld.param.u32 %r3, [pkvdim];
  mov.u32 %r4, %tid.x;
  setp.ge.u32 %p1, %r4, %r1;
  @%p1 bra DONE;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r5, 0;
VLOOP:
  setp.ge.u32 %p2, %r5, %r2;
  @%p2 bra VDONE;
  mul.wide.u32 %rd4, %r5, 4;
  add.u64 %rd5, %rd1, %rd4;
  ld.global.f32 %f2, [%rd5];
  mul.lo.u32 %r6, %r5, %r3;
  add.u32 %r6, %r6, %r4;
  mul.wide.u32 %rd6, %r6, 4;
  add.u64 %rd6, %rd2, %rd6;
  ld.global.f32 %f3, [%rd6];
  mad.f32 %f1, %f2, %f3, %f1;
  add.u32 %r5, %r5, 1;
  bra VLOOP;
VDONE:
  mul.wide.u32 %rd7, %r4, 4;
  add.u64 %rd7, %rd3, %rd7;
  st.global.f32 [%rd7], %f1;
