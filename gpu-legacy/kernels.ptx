.visible .entry k_attn_scores(.param .u64 pq, .param .u64 pk, .param .u64 pscores,
                              .param .u32 phs, .param .u32 pT, .param .u32 pkvdim)
{
  .reg .u32 %r<14>;
  .reg .u64 %rd<12>;
  .reg .f32 %f<8>;
  .reg .pred %p<3>;
  ld.param.u64 %rd1, [pq];
  ld.param.u64 %rd2, [pk];
  ld.param.u64 %rd3, [pscores];
  ld.param.u32 %r1, [phs];
  ld.param.u32 %r2, [pT];
  ld.param.u32 %r3, [pkvdim];
  mov.u32 %r4, %tid.x;
  setp.ge.u32 %p1, %r4, %r2;
  @%p1 bra DONE;
  mul.lo.u32 %r5, %r4, %r3;
  mul.wide.u32 %rd4, %r5, 4;
  add.u64 %rd4, %rd2, %rd4;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r6, 0;
DOT:
  setp.ge.u32 %p2, %r6, %r1;
  @%p2 bra DOTD;
  mul.wide.u32 %rd5, %r6, 4;
  add.u64 %rd6, %rd1, %rd5;
  add.u64 %rd7, %rd4, %rd5;
  ld.global.f32 %f2, [%rd6];
  ld.global.f32 %f3, [%rd7];
  mad.f32 %f1, %f2, %f3, %f1;
  add.u32 %r6, %r6, 1;
  bra DOT;
DOTD:
  cvt.rn.f32.u32 %f4, %r1;
  sqrt.approx.f32 %f4, %f4;
  div.approx.f32 %f1, %f1, %f4;
  mul.wide.u32 %rd8, %r4, 4;
  add.u64 %rd8, %rd3, %rd8;
  st.global.f32 [%rd8], %f1;
DONE:
  exit;
}

.visible .entry k_softmax(.param .u64 pscores, .param .u32 pT)
{
  .reg .u32 %r<12>;
  .reg .u64 %rd<10>;
  .reg .f32 %f<10>;
  .reg .pred %p<4>;
  .shared .align 4 .f32 sm[128];
  ld.param.u64 %rd1, [pscores];
  ld.param.u32 %r2, [pT];
  mov.u32 %r3, %tid.x;
  mov.f32 %f5, 0fff7fffff;
  mov.u32 %r4, %r3;
MLOOP:
  setp.ge.u32 %p1, %r4, %r2;
  @%p1 bra MAFTER;
  mul.wide.u32 %rd2, %r4, 4;
  add.u64 %rd3, %rd1, %rd2;
  ld.global.f32 %f1, [%rd3];
  max.f32 %f5, %f5, %f1;
  add.u32 %r4, %r4, 128;
  bra MLOOP;
MAFTER:
  mov.u64 %rd7, sm;
  mul.wide.u32 %rd8, %r3, 4;
  add.u64 %rd8, %rd7, %rd8;
  st.shared.f32 [%rd8], %f5;
  mov.u32 %r4, 64;
MR:
  bar.sync 0;
  setp.ge.u32 %p2, %r3, %r4;
  @%p2 bra MRS;
  mul.wide.u32 %rd5, %r4, 4;
  add.u64 %rd6, %rd8, %rd5;
  ld.shared.f32 %f1, [%rd8];
  ld.shared.f32 %f2, [%rd6];
  max.f32 %f1, %f1, %f2;
  st.shared.f32 [%rd8], %f1;
MRS:
  shr.u32 %r4, %r4, 1;
  setp.ne.u32 %p3, %r4, 0;
  @%p3 bra MR;
  bar.sync 0;
  ld.shared.f32 %f5, [%rd7];
  mov.f32 %f8, 0f00000000;
  mov.u32 %r4, %r3;
ELOOP:
  setp.ge.u32 %p1, %r4, %r2;
  @%p1 bra EAFTER;
  mul.wide.u32 %rd2, %r4, 4;
  add.u64 %rd3, %rd1, %rd2;
  ld.global.f32 %f1, [%rd3];
  sub.f32 %f1, %f1, %f5;
  mul.f32 %f1, %f1, 0f3fb8aa3b;
  ex2.approx.f32 %f1, %f1;
  add.f32 %f8, %f8, %f1;
  add.u32 %r4, %r4, 128;
  bra ELOOP;
EAFTER:
  st.shared.f32 [%rd8], %f8;
  mov.u32 %r4, 64;
SR:
  bar.sync 0;
  setp.ge.u32 %p2, %r3, %r4;
  @%p2 bra SRS;
  mul.wide.u32 %rd5, %r4, 4;
  add.u64 %rd6, %rd8, %rd5;
  ld.shared.f32 %f1, [%rd8];
  ld.shared.f32 %f2, [%rd6];
  add.f32 %f1, %f1, %f2;
  st.shared.f32 [%rd8], %f1;
SRS:
  shr.u32 %r4, %r4, 1;
  setp.ne.u32 %p3, %r4, 0;
  @%p3 bra SR;
  bar.sync 0;
  ld.shared.f32 %f8, [%rd7];
  rcp.approx.f32 %f8, %f8;
  mov.u32 %r4, %r3;
NLOOP:
  setp.ge.u32 %p1, %r4, %r2;
  @%p1 bra DONE;
  mul.wide.u32 %rd2, %r4, 4;
  add.u64 %rd3, %rd1, %rd2;
  ld.global.f32 %f1, [%rd3];
  sub.f32 %f1, %f1, %f5;
  mul.f32 %f1, %f1, 0f3fb8aa3b;
  ex2.approx.f32 %f1, %f1;
  mul.f32 %f1, %f1, %f8;
  st.global.f32 [%rd3], %f1;
