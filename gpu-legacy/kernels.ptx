  exit;
}

// Fused per-head attention: scores + softmax + value. 1 block, 128 threads. T<=256, hs<=128.
.visible .entry k_attn_fused(.param .u64 pq, .param .u64 pk, .param .u64 pv, .param .u64 pxb,
                             .param .u32 phs, .param .u32 pT, .param .u32 pkvdim)
{
  .reg .u32 %r<16>;
  .reg .u64 %rd<14>;
  .reg .f32 %f<12>;
  .reg .pred %p<4>;
  .shared .align 4 .f32 att[256];
  .shared .align 4 .f32 red[128];
  ld.param.u64 %rd1, [pq];
  ld.param.u64 %rd2, [pk];
  ld.param.u64 %rd3, [pv];
  ld.param.u64 %rd4, [pxb];
  ld.param.u32 %r1, [phs];
  ld.param.u32 %r2, [pT];
  ld.param.u32 %r3, [pkvdim];
  mov.u32 %r4, %tid.x;
  // scores into att[t]
  setp.ge.u32 %p1, %r4, %r2;
  @%p1 bra AFTER_SCORES;
  mul.lo.u32 %r5, %r4, %r3;
  mul.wide.u32 %rd5, %r5, 4;
  add.u64 %rd5, %rd2, %rd5;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r6, 0;
DOT:
  setp.ge.u32 %p2, %r6, %r1;
  @%p2 bra DOTD;
  mul.wide.u32 %rd6, %r6, 4;
  add.u64 %rd7, %rd1, %rd6;
  add.u64 %rd8, %rd5, %rd6;
  ld.global.f32 %f2, [%rd7];
  ld.global.f32 %f3, [%rd8];
  mad.f32 %f1, %f2, %f3, %f1;
  add.u32 %r6, %r6, 1;
  bra DOT;
DOTD:
  cvt.rn.f32.u32 %f4, %r1;
  sqrt.approx.f32 %f4, %f4;
  div.approx.f32 %f1, %f1, %f4;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r4, 4;
  add.u64 %rd10, %rd9, %rd10;
  st.shared.f32 [%rd10], %f1;
AFTER_SCORES:
  bar.sync 0;
  // max
  mov.f32 %f5, 0fff7fffff;
  mov.u32 %r6, %r4;
MLOOP:
  setp.ge.u32 %p1, %r6, %r2;
  @%p1 bra MAFTER;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f1, [%rd10];
  max.f32 %f5, %f5, %f1;
  add.u32 %r6, %r6, 128;
  bra MLOOP;
MAFTER:
  mov.u64 %rd11, red;
  mul.wide.u32 %rd12, %r4, 4;
  add.u64 %rd12, %rd11, %rd12;
  st.shared.f32 [%rd12], %f5;
  mov.u32 %r6, 64;
MR:
  bar.sync 0;
  setp.ge.u32 %p2, %r4, %r6;
  @%p2 bra MRS;
  mul.wide.u32 %rd5, %r6, 4;
  add.u64 %rd6, %rd12, %rd5;
  ld.shared.f32 %f1, [%rd12];
  ld.shared.f32 %f2, [%rd6];
  max.f32 %f1, %f1, %f2;
  st.shared.f32 [%rd12], %f1;
MRS:
  shr.u32 %r6, %r6, 1;
  setp.ne.u32 %p3, %r6, 0;
  @%p3 bra MR;
  bar.sync 0;
  ld.shared.f32 %f5, [%rd11];
  // exp + sum
  mov.f32 %f8, 0f00000000;
  mov.u32 %r6, %r4;
ELOOP:
  setp.ge.u32 %p1, %r6, %r2;
  @%p1 bra EAFTER;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f1, [%rd10];
  sub.f32 %f1, %f1, %f5;
  mul.f32 %f1, %f1, 0f3fb8aa3b;
  ex2.approx.f32 %f1, %f1;
  st.shared.f32 [%rd10], %f1;
  add.f32 %f8, %f8, %f1;
  add.u32 %r6, %r6, 128;
  bra ELOOP;
EAFTER:
  st.shared.f32 [%rd12], %f8;
  mov.u32 %r6, 64;
SR:
  bar.sync 0;
  setp.ge.u32 %p2, %r4, %r6;
  @%p2 bra SRS;
  mul.wide.u32 %rd5, %r6, 4;
  add.u64 %rd6, %rd12, %rd5;
  ld.shared.f32 %f1, [%rd12];
  ld.shared.f32 %f2, [%rd6];
  add.f32 %f1, %f1, %f2;
  st.shared.f32 [%rd12], %f1;
SRS:
  shr.u32 %r6, %r6, 1;
  setp.ne.u32 %p3, %r6, 0;
  @%p3 bra SR;
  bar.sync 0;
  ld.shared.f32 %f8, [%rd11];
  rcp.approx.f32 %f8, %f8;
  // normalize att
  mov.u32 %r6, %r4;
NLOOP:
  setp.ge.u32 %p1, %r6, %r2;
  @%p1 bra NAFTER;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f1, [%rd10];
  mul.f32 %f1, %f1, %f8;
  st.shared.f32 [%rd10], %f1;
  add.u32 %r6, %r6, 128;
  bra NLOOP;
NAFTER:
  bar.sync 0;
  // value weighted sum
  setp.ge.u32 %p1, %r4, %r1;
  @%p1 bra DONE;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r6, 0;
VLOOP:
  setp.ge.u32 %p2, %r6, %r2;
  @%p2 bra VDONE;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f2, [%rd10];
  mul.lo.u32 %r7, %r6, %r3;
  add.u32 %r7, %r7, %r4;
  mul.wide.u32 %rd6, %r7, 4;
  add.u64 %rd6, %rd3, %rd6;
  ld.global.f32 %f3, [%rd6];
  mad.f32 %f1, %f2, %f3, %f1;
  add.u32 %r6, %r6, 1;
  bra VLOOP;
VDONE:
  mul.wide.u32 %rd7, %r4, 4;
  add.u64 %rd7, %rd4, %rd7;
  st.global.f32 [%rd7], %f1;
DONE:
  exit;
}
.visible .entry k_attn_mh(.param .u64 pq, .param .u64 pk, .param .u64 pv, .param .u64 pxb,
                             .param .u32 phs, .param .u32 pT, .param .u32 pkvdim, .param .u32 pkm)
{
  .reg .u64 %rx<4>; .reg .u32 %rh<4>;
  .reg .u32 %r<16>;
  .reg .u64 %rd<14>;
  .reg .f32 %f<12>;
  .reg .pred %p<4>;
  .shared .align 4 .f32 att[256];
  .shared .align 4 .f32 red[128];
  ld.param.u64 %rd1, [pq];
  ld.param.u64 %rd2, [pk];
  ld.param.u64 %rd3, [pv];
  ld.param.u64 %rd4, [pxb];
  ld.param.u32 %r1, [phs];
  ld.param.u32 %r2, [pT];
  ld.param.u32 %r3, [pkvdim];
  mov.u32 %rh0, %ctaid.x; ld.param.u32 %rh1, [pkm]; div.u32 %rh2, %rh0, %rh1;
  mul.lo.u32 %rh0, %rh0, %r1; mul.wide.u32 %rx0, %rh0, 4; add.u64 %rd1, %rd1, %rx0; add.u64 %rd4, %rd4, %rx0;
  mul.lo.u32 %rh2, %rh2, %r1; mul.wide.u32 %rx1, %rh2, 4; add.u64 %rd2, %rd2, %rx1; add.u64 %rd3, %rd3, %rx1;
  mov.u32 %r4, %tid.x;
  // scores into att[t]
  setp.ge.u32 %p1, %r4, %r2;
  @%p1 bra AFTER_SCORES;
  mul.lo.u32 %r5, %r4, %r3;
  mul.wide.u32 %rd5, %r5, 4;
  add.u64 %rd5, %rd2, %rd5;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r6, 0;
DOT:
  setp.ge.u32 %p2, %r6, %r1;
  @%p2 bra DOTD;
  mul.wide.u32 %rd6, %r6, 4;
  add.u64 %rd7, %rd1, %rd6;
  add.u64 %rd8, %rd5, %rd6;
  ld.global.f32 %f2, [%rd7];
  ld.global.f32 %f3, [%rd8];
  mad.f32 %f1, %f2, %f3, %f1;
  add.u32 %r6, %r6, 1;
  bra DOT;
DOTD:
  cvt.rn.f32.u32 %f4, %r1;
  sqrt.approx.f32 %f4, %f4;
  div.approx.f32 %f1, %f1, %f4;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r4, 4;
  add.u64 %rd10, %rd9, %rd10;
  st.shared.f32 [%rd10], %f1;
AFTER_SCORES:
  bar.sync 0;
  // max
  mov.f32 %f5, 0fff7fffff;
  mov.u32 %r6, %r4;
MLOOP:
  setp.ge.u32 %p1, %r6, %r2;
  @%p1 bra MAFTER;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f1, [%rd10];
  max.f32 %f5, %f5, %f1;
  add.u32 %r6, %r6, 128;
  bra MLOOP;
MAFTER:
  mov.u64 %rd11, red;
  mul.wide.u32 %rd12, %r4, 4;
  add.u64 %rd12, %rd11, %rd12;
  st.shared.f32 [%rd12], %f5;
  mov.u32 %r6, 64;
MR:
  bar.sync 0;
  setp.ge.u32 %p2, %r4, %r6;
  @%p2 bra MRS;
  mul.wide.u32 %rd5, %r6, 4;
  add.u64 %rd6, %rd12, %rd5;
  ld.shared.f32 %f1, [%rd12];
  ld.shared.f32 %f2, [%rd6];
  max.f32 %f1, %f1, %f2;
  st.shared.f32 [%rd12], %f1;
MRS:
  shr.u32 %r6, %r6, 1;
  setp.ne.u32 %p3, %r6, 0;
  @%p3 bra MR;
  bar.sync 0;
  ld.shared.f32 %f5, [%rd11];
  // exp + sum
  mov.f32 %f8, 0f00000000;
  mov.u32 %r6, %r4;
ELOOP:
  setp.ge.u32 %p1, %r6, %r2;
  @%p1 bra EAFTER;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f1, [%rd10];
  sub.f32 %f1, %f1, %f5;
  mul.f32 %f1, %f1, 0f3fb8aa3b;
  ex2.approx.f32 %f1, %f1;
  st.shared.f32 [%rd10], %f1;
  add.f32 %f8, %f8, %f1;
  add.u32 %r6, %r6, 128;
  bra ELOOP;
EAFTER:
  st.shared.f32 [%rd12], %f8;
  mov.u32 %r6, 64;
SR:
  bar.sync 0;
  setp.ge.u32 %p2, %r4, %r6;
  @%p2 bra SRS;
  mul.wide.u32 %rd5, %r6, 4;
  add.u64 %rd6, %rd12, %rd5;
  ld.shared.f32 %f1, [%rd12];
  ld.shared.f32 %f2, [%rd6];
  add.f32 %f1, %f1, %f2;
  st.shared.f32 [%rd12], %f1;
SRS:
  shr.u32 %r6, %r6, 1;
  setp.ne.u32 %p3, %r6, 0;
  @%p3 bra SR;
  bar.sync 0;
  ld.shared.f32 %f8, [%rd11];
  rcp.approx.f32 %f8, %f8;
  // normalize att
  mov.u32 %r6, %r4;
NLOOP:
  setp.ge.u32 %p1, %r6, %r2;
  @%p1 bra NAFTER;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f1, [%rd10];
  mul.f32 %f1, %f1, %f8;
  st.shared.f32 [%rd10], %f1;
  add.u32 %r6, %r6, 128;
  bra NLOOP;
NAFTER:
  bar.sync 0;
  // value weighted sum
  setp.ge.u32 %p1, %r4, %r1;
  @%p1 bra DONE;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r6, 0;
VLOOP:
  setp.ge.u32 %p2, %r6, %r2;
  @%p2 bra VDONE;
  mov.u64 %rd9, att;
  mul.wide.u32 %rd10, %r6, 4;
  add.u64 %rd10, %rd9, %rd10;
  ld.shared.f32 %f2, [%rd10];
  mul.lo.u32 %r7, %r6, %r3;
  add.u32 %r7, %r7, %r4;
  mul.wide.u32 %rd6, %r7, 4;
  add.u64 %rd6, %rd3, %rd6;
  ld.global.f32 %f3, [%rd6];
  mad.f32 %f1, %f2, %f3, %f1;
  add.u32 %r6, %r6, 1;
  bra VLOOP;
VDONE:
  mul.wide.u32 %rd7, %r4, 4;
  add.u64 %rd7, %rd4, %rd7;
  st.global.f32 [%rd7], %f1;
DONE:
  exit;
}

//   block_q4_0 { ggml_fp16_t d; uint8_t qs[16]; }  // 18 bytes, two nibbles per byte
// y[row] = sum_j w[row,j] * x[j]
// Grid: one block per output row. Threads stride over input blocks.

// half->float: sm_11 has no native half; unpack IEEE754 binary16 in PTX.
// d is stored as u16 at start of each 18-byte block.

// Q4_0 dequant-matvec. block_q4_0 = {u16 d; u8 qs[16];} 18 bytes, 32 weights.
// Software f16->f32 (no cvt.f32.f16 required).
.visible .entry k_q4_matvec_v1(.param .u64 py, .param .u64 px, .param .u64 pw, .param .u32 pn, .param .u32 pd)
{
  .reg .u32 %r<40>;
  .reg .u64 %rd<24>;
  .reg .f32 %f<20>;
  .reg .pred %p<10>;
  .shared .align 4 .f32 sm[128];

  ld.param.u64 %rd1, [py];
  ld.param.u64 %rd2, [px];
  ld.param.u64 %rd3, [pw];
  ld.param.u32 %r1, [pn];
  ld.param.u32 %r2, [pd];
  mov.u32 %r3, %ctaid.x;
  setp.ge.u32 %p1, %r3, %r2;
  @%p1 bra DONE;
  mov.u32 %r4, %tid.x;
  shr.u32 %r5, %r1, 5;                 // n/32 blocks/row
  mul.lo.u32 %r6, %r3, %r5;
  mul.lo.u32 %r6, %r6, 18;
  mul.wide.u32 %rd4, %r6, 1;
  add.u64 %rd4, %rd3, %rd4;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r7, %r4;
BLOOP:
  setp.ge.u32 %p2, %r7, %r5;
  @%p2 bra RED;
  mul.lo.u32 %r8, %r7, 18;
  mul.wide.u32 %rd5, %r8, 1;
  add.u64 %rd5, %rd4, %rd5;
  ld.global.u16 %r9, [%rd5];           // f16 bits
  // f16 -> f32
  and.b32 %r20, %r9, 0x8000;           // sign
  shr.u32 %r21, %r9, 10;
  and.b32 %r21, %r21, 0x1f;            // exp
  and.b32 %r22, %r9, 0x3ff;            // mant
  setp.eq.u32 %p7, %r21, 0;
  @%p7 bra DENORM;
  setp.eq.u32 %p8, %r21, 31;
  @%p8 bra INFNAN;
  add.u32 %r21, %r21, 112;             // rebias 127-15
  shl.b32 %r21, %r21, 23;
  shl.b32 %r22, %r22, 13;
  or.b32 %r23, %r21, %r22;
  shl.b32 %r20, %r20, 16;
  or.b32 %r23, %r23, %r20;
  mov.b32 %f2, %r23;
  bra HAVED;
DENORM:
  mov.f32 %f2, 0f00000000;
  bra HAVED;
INFNAN:
  mov.f32 %f2, 0f7f800000;
HAVED:
  add.u64 %rd6, %rd5, 2;
  shl.b32 %r10, %r7, 5;
  mul.wide.u32 %rd7, %r10, 4;
  add.u64 %rd7, %rd2, %rd7;
  mov.u32 %r11, 0;
QLOOP:
  setp.ge.u32 %p3, %r11, 16;
  @%p3 bra QDONE;
  mul.wide.u32 %rd9, %r11, 1;
  add.u64 %rd8, %rd6, %rd9;
  ld.global.u8 %r12, [%rd8];
  // GGML Q4_0: low nibble -> j, high -> j+16
  and.b32 %r13, %r12, 15;
  sub.s32 %r13, %r13, 8;
  cvt.rn.f32.s32 %f3, %r13;
  mul.f32 %f3, %f3, %f2;
  mul.wide.u32 %rd11, %r11, 4;
  add.u64 %rd11, %rd7, %rd11;
  ld.global.f32 %f4, [%rd11];
  mad.f32 %f1, %f3, %f4, %f1;
  shr.u32 %r13, %r12, 4;
  and.b32 %r13, %r13, 15;
  sub.s32 %r13, %r13, 8;
  cvt.rn.f32.s32 %f3, %r13;
  mul.f32 %f3, %f3, %f2;
  add.u32 %r14, %r11, 16;
  mul.wide.u32 %rd11, %r14, 4;
  add.u64 %rd11, %rd7, %rd11;
  ld.global.f32 %f4, [%rd11];
  mad.f32 %f1, %f3, %f4, %f1;
  add.u32 %r11, %r11, 1;
  bra QLOOP;
QDONE:
  add.u32 %r7, %r7, 128;
  bra BLOOP;
RED:
  mov.u64 %rd12, sm;
  mul.wide.u32 %rd13, %r4, 4;
  add.u64 %rd13, %rd12, %rd13;
  st.shared.f32 [%rd13], %f1;
  mov.u32 %r15, 64;
RLOOP:
  bar.sync 0;
  setp.ge.u32 %p4, %r4, %r15;
  @%p4 bra RSKIP;
  mul.wide.u32 %rd14, %r15, 4;
  add.u64 %rd14, %rd13, %rd14;
  ld.shared.f32 %f5, [%rd13];
  ld.shared.f32 %f6, [%rd14];
  add.f32 %f5, %f5, %f6;
  st.shared.f32 [%rd13], %f5;
RSKIP:
  shr.u32 %r15, %r15, 1;
  setp.ne.u32 %p5, %r15, 0;
  @%p5 bra RLOOP;
  setp.ne.u32 %p6, %r4, 0;
  @%p6 bra DONE;
  ld.shared.f32 %f7, [%rd12];
  mul.wide.u32 %rd15, %r3, 4;
  add.u64 %rd15, %rd1, %rd15;
  st.global.f32 [%rd15], %f7;
DONE:
  exit;
}

// Q8_0: block {f16 d; int8 qs[32];} = 34 bytes
.visible .entry k_q8_matvec_v1(.param .u64 py, .param .u64 px, .param .u64 pw, .param .u32 pn, .param .u32 pd)
{
  .reg .u32 %r<40>;
  .reg .u64 %rd<20>;
  .reg .f32 %f<16>;
  .reg .pred %p<10>;
  .shared .align 4 .f32 sm[128];
  ld.param.u64 %rd1, [py]; ld.param.u64 %rd2, [px]; ld.param.u64 %rd3, [pw];
  ld.param.u32 %r1, [pn]; ld.param.u32 %r2, [pd];
  mov.u32 %r3, %ctaid.x; setp.ge.u32 %p1, %r3, %r2; @%p1 bra DONE;
  mov.u32 %r4, %tid.x; shr.u32 %r5, %r1, 5;
  mul.lo.u32 %r6, %r3, %r5; mul.lo.u32 %r6, %r6, 34;
  mul.wide.u32 %rd4, %r6, 1; add.u64 %rd4, %rd3, %rd4;
  mov.f32 %f1, 0f00000000; mov.u32 %r7, %r4;
BLOOP:
  setp.ge.u32 %p2, %r7, %r5; @%p2 bra RED;
  mul.lo.u32 %r8, %r7, 34; mul.wide.u32 %rd5, %r8, 1; add.u64 %rd5, %rd4, %rd5;
  ld.global.u16 %r9, [%rd5];
  and.b32 %r20, %r9, 0x8000; shr.u32 %r21, %r9, 10; and.b32 %r21, %r21, 0x1f; and.b32 %r22, %r9, 0x3ff;
  setp.eq.u32 %p7, %r21, 0; @%p7 bra DENORM;
  add.u32 %r21, %r21, 112; shl.b32 %r21, %r21, 23; shl.b32 %r22, %r22, 13;
  or.b32 %r23, %r21, %r22; shl.b32 %r20, %r20, 16; or.b32 %r23, %r23, %r20; mov.b32 %f2, %r23; bra HAVED;
DENORM: mov.f32 %f2, 0f00000000;
HAVED:
  add.u64 %rd6, %rd5, 2; shl.b32 %r10, %r7, 5; mul.wide.u32 %rd7, %r10, 4; add.u64 %rd7, %rd2, %rd7;
  mov.u32 %r11, 0;
QLOOP:
  setp.ge.u32 %p3, %r11, 32; @%p3 bra QDONE;
  mul.wide.u32 %rd9, %r11, 1; add.u64 %rd8, %rd6, %rd9;
  ld.global.s8 %r12, [%rd8];
  cvt.rn.f32.s32 %f3, %r12; mul.f32 %f3, %f3, %f2;
  mul.wide.u32 %rd11, %r11, 4; add.u64 %rd11, %rd7, %rd11;
  ld.global.f32 %f4, [%rd11]; mad.f32 %f1, %f3, %f4, %f1;
  add.u32 %r11, %r11, 1; bra QLOOP;
QDONE: add.u32 %r7, %r7, 128; bra BLOOP;
RED:
  mov.u64 %rd12, sm; mul.wide.u32 %rd13, %r4, 4; add.u64 %rd13, %rd12, %rd13; st.shared.f32 [%rd13], %f1;
  mov.u32 %r15, 64;
RLOOP: bar.sync 0; setp.ge.u32 %p4, %r4, %r15; @%p4 bra RSKIP;
  mul.wide.u32 %rd14, %r15, 4; add.u64 %rd14, %rd13, %rd14;
  ld.shared.f32 %f5, [%rd13]; ld.shared.f32 %f6, [%rd14]; add.f32 %f5, %f5, %f6; st.shared.f32 [%rd13], %f5;
RSKIP: shr.u32 %r15, %r15, 1; setp.ne.u32 %p5, %r15, 0; @%p5 bra RLOOP;
  setp.ne.u32 %p6, %r4, 0; @%p6 bra DONE;
  ld.shared.f32 %f7, [%rd12]; mul.wide.u32 %rd15, %r3, 4; add.u64 %rd15, %rd1, %rd15; st.global.f32 [%rd15], %f7;
DONE: exit;
}


// Optimized Q4_0 matvec for G84 (sm_11, 4 SMs, 16KB smem):
// - x cached in shared memory (coalesced load)
// - each block owns ROWS_PER_BLOCK output rows (grid = ceil(d/ROWS))
// - 64 threads/block (good occupancy on 8192-reg SM)
// - GGML layout: low nibble -> j, high -> j+16
.visible .entry k_q4_matvec(.param .u64 py, .param .u64 px, .param .u64 pw, .param .u32 pn, .param .u32 pd)
{
  .reg .u32 %r<48>;
  .reg .u64 %rd<28>;
  .reg .f32 %f<24>;
  .reg .pred %p<12>;
  .shared .align 4 .f32 sx[1536];
  .shared .align 4 .f32 sm[64];
  ld.param.u64 %rd1, [py]; ld.param.u64 %rd2, [px]; ld.param.u64 %rd3, [pw];
  ld.param.u32 %r1, [pn]; ld.param.u32 %r2, [pd];
  mov.u32 %r4, %tid.x;
  mov.u32 %r7, %r4;
XLOAD: setp.ge.u32 %p2, %r7, %r1; @%p2 bra XDONE;
  mul.wide.u32 %rd6, %r7, 4; add.u64 %rd7, %rd2, %rd6; ld.global.f32 %f0, [%rd7];
  mov.u64 %rd8, sx; add.u64 %rd8, %rd8, %rd6; st.shared.f32 [%rd8], %f0;
  add.u32 %r7, %r7, 64; bra XLOAD;
XDONE:
  shr.u32 %r5, %r1, 5;
  and.b32 %r31, %r4, 3;            // sub quarter
  shr.u32 %r32, %r4, 2;            // block lane 0..15
  mov.u32 %r3, %ctaid.x;
  mov.u32 %r30, %nctaid.x;
ROW:
  bar.sync 0;
  setp.ge.u32 %p1, %r3, %r2; @%p1 bra DONE;
  mul.lo.u32 %r6, %r3, %r5; mul.lo.u32 %r6, %r6, 18;
  mul.wide.u32 %rd4, %r6, 1; add.u64 %rd4, %rd3, %rd4;
  mov.f32 %f1, 0f00000000;
  mov.u32 %r7, %r32;
BLOOP:
  setp.ge.u32 %p2, %r7, %r5; @%p2 bra RED;
  mul.lo.u32 %r8, %r7, 18; mul.wide.u32 %rd5, %r8, 1; add.u64 %rd5, %rd4, %rd5;
