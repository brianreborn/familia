.visible .entry k_attn_value(.param .u64 pscores, .param .u64 pv, .param .u64 pxb,
                             .param .u32 phs, .param .u32 pT, .param .u32 pkvdim)
{
  .reg .u32 %r<14>;
  .reg .u64 %rd<12>;
  .reg .f32 %f<6>;
  .reg .pred %p<3>;
