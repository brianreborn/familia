  ex2.approx.f32 %f3, %f3;
  add.f32 %f3, %f3, 0f3f800000;
  rcp.approx.f32 %f3, %f3;
  mul.f32 %f1, %f1, %f3;
  mul.f32 %f1, %f1, %f2;
  st.global.f32 [%rd4], %f1;
DONE:
  exit;
}

.visible .entry k_rope(.param .u64 pq, .param .u64 pk, .param .u64 pcos, .param .u64 psin,
                       .param .u32 pdim, .param .u32 phs, .param .u32 pkv)
{
  .reg .u32 %r<14>;
  .reg .u64 %rd<14>;
  .reg .f32 %f<10>;
  .reg .pred %p<4>;
  ld.param.u64 %rd1, [pq];
  ld.param.u64 %rd2, [pk];
  ld.param.u64 %rd3, [pcos];
  ld.param.u64 %rd4, [psin];
  ld.param.u32 %r1, [pdim];
  ld.param.u32 %r2, [phs];
  ld.param.u32 %r3, [pkv];
  mov.u32 %r4, %ctaid.x;
  mov.u32 %r5, %ntid.x;
  mov.u32 %r6, %tid.x;
  mad.lo.u32 %r7, %r4, %r5, %r6;
  shl.b32 %r7, %r7, 1;
  setp.ge.u32 %p1, %r7, %r1;
  @%p1 bra DONE;
  rem.u32 %r8, %r7, %r2;
  shr.u32 %r8, %r8, 1;
  mul.wide.u32 %rd5, %r8, 4;
  add.u64 %rd6, %rd3, %rd5;
  add.u64 %rd7, %rd4, %rd5;
  ld.global.f32 %f1, [%rd6];
  ld.global.f32 %f2, [%rd7];
  mul.wide.u32 %rd8, %r7, 4;
  add.u64 %rd9, %rd1, %rd8;
  ld.global.f32 %f3, [%rd9];
  add.u64 %rd10, %rd9, 4;
  ld.global.f32 %f4, [%rd10];
  mul.f32 %f5, %f3, %f1;
  mul.f32 %f6, %f4, %f2;
  sub.f32 %f5, %f5, %f6;
  mul.f32 %f6, %f3, %f2;
  mul.f32 %f7, %f4, %f1;
  add.f32 %f6, %f6, %f7;
  st.global.f32 [%rd9], %f5;
  st.global.f32 [%rd10], %f6;
  setp.ge.u32 %p2, %r7, %r3;
  @%p2 bra DONE;
  add.u64 %rd9, %rd2, %rd8;
  ld.global.f32 %f3, [%rd9];
  add.u64 %rd10, %rd9, 4;
  ld.global.f32 %f4, [%rd10];
  mul.f32 %f5, %f3, %f1;
  mul.f32 %f6, %f4, %f2;
  sub.f32 %f5, %f5, %f6;
  mul.f32 %f6, %f3, %f2;
  mul.f32 %f7, %f4, %f1;
  add.f32 %f6, %f6, %f7;
  st.global.f32 [%rd9], %f5;
  st.global.f32 [%rd10], %f6;
DONE:
  exit;
}

