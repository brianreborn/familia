  setp.ge.u32 %p1, %r6, %r1;
  @%p1 bra DONE;
  mul.wide.u32 %rd3, %r6, 4;
  add.u64 %rd4, %rd1, %rd3;
  add.u64 %rd5, %rd2, %rd3;
  ld.global.f32 %f1, [%rd4];
  ld.global.f32 %f2, [%rd5];
  add.f32 %f1, %f1, %f2;
  st.global.f32 [%rd4], %f1;
DONE:
  exit;
}

.visible .entry k_silu_mul(.param .u64 phb, .param .u64 phb2, .param .u32 pn)
