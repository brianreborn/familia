# FreeBSD only — module build (needs bsd.kmod.mk and kernel sources):
#   make -f Makefile.kmod
# That produces nvso.ko when the FreeBSD build succeeds. Loading it, and any
# later nvsoctl round-trip, is live integration and is outside the userspace smoke.
#
# device_if.h / bus_if.h are generated by bsd.kmod.mk when listed in SRCS.
KMOD=   nvso
SRCS=   nvso.c nvso_ssd.c nvso_gpu.c
SRCS+=  device_if.h bus_if.h
.PATH:  ${.CURDIR}/sys
CFLAGS+= -I${.CURDIR}/include -I${.CURDIR}/sys
.include <bsd.kmod.mk>
